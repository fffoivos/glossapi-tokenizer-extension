# Frozen 25B full-corpus TD recipe. This is a single continuous 79/20/1 blend,
# not the historical 13.5B two-phase curriculum sweep. The common file remains
# shared with legacy bakeoffs, so every full-run semantic is overwritten below
# after both shared environments have been sourced.
FULL_CPT_REQUIRE_JOB_START_VERIFY="1"
: "${BRIDGE_DATA_ENV:?set BRIDGE_DATA_ENV to the finalized training_data.env}"
test -s "$BRIDGE_DATA_ENV" || { echo "ERROR: bridge data env missing: $BRIDGE_DATA_ENV" >&2; return 2; }

THIS_CONFIG_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
FULL_CPT_EFFECTIVE_COMMON_TRAINING_ENV="$(cd "$THIS_CONFIG_DIR/../../03_training_experiments/configs" && pwd)/common_cpt.env"
source "$FULL_CPT_EFFECTIVE_COMMON_TRAINING_ENV"
source "$BRIDGE_DATA_ENV"

: "${FULL_CPT_TOKENIZER_DIR:?finalized bridge did not export FULL_CPT_TOKENIZER_DIR}"
: "${FULL_CPT_DATA_PREFIX:?finalized bridge did not export FULL_CPT_DATA_PREFIX}"
: "${VAL_DATA_DIR:?finalized bridge did not export VAL_DATA_DIR}"
: "${EXTRA_VALID_SETS:?finalized bridge did not export EXTRA_VALID_SETS}"

# Identity, exact receipt-owned paths, and immutable runtime.
ARM="td"
ARM_NAME="full_corpus_td_25b_79_20_1"
if [[ -n "${FULL_CPT_VERIFY_EXPECTED_LOAD_CHECKPOINT:-}" ]]; then
    INIT_CKPT="$FULL_CPT_VERIFY_EXPECTED_LOAD_CHECKPOINT"
fi
if [[ -n "${FULL_CPT_VERIFY_EXPECTED_MEGATRON_DIR:-}" ]]; then
    MEGATRON_LM_SWISSAI_DIR="$FULL_CPT_VERIFY_EXPECTED_MEGATRON_DIR"
fi
UENV_IMAGE="pytorch/v2.9.1:v2"

# Optimizer and schedule.
ADEMA_BETA1="0.9"
ADEMA_BETA2="0.999"
ADEMA_BETA3="0.999"
ADEMA_ALPHA="4.0"
ADEMA_WEIGHT_DECAY="0.1"
ADEMA_BETA_START="0.9"
GRAD_CLIP="0.1"
INIT_STD="0.008944"
LR_PEAK="5.5e-5"
LR_FINAL="5.5e-6"
LR_WARMUP_INIT="5.5e-6"
LR_SCHEDULE_STYLE="WSD"
LR_DECAY_STYLE="1-sqrt"
LR_WARMUP_ITERS="400"

# Apertus main-pretraining geometry, batch, precision, and parallelism.
SEQ_LENGTH="4096"
SEQ_LEN="$SEQ_LENGTH"
MAX_POSITION_EMBEDDINGS="4096"
ROTARY_BASE="500000"
USE_ROPE_SCALING="1"
ROPE_SCALING_FACTOR="8.0"
MAKE_VOCAB_SIZE_DIVISIBLE_BY="256"
MICROBATCH_SIZE="2"
GLOBAL_BATCH_SIZE="1024"
GLOBAL_BATCH_TOKENS="4194304"
MIXED_PRECISION_FLAG="--bf16"
MAIN_GRADS_DTYPE="fp32"
TENSOR_MODEL_PARALLEL_SIZE="2"
PIPELINE_MODEL_PARALLEL_SIZE="1"
ACTIVATION_FLAG="--xielu"
XIELU_INIT_AP="0.8"
XIELU_INIT_AN="0.8"
QK_LAYERNORM_FLAG="--qk-layernorm"
QKNORM_IMPL="apex"
NORMALIZATION="RMSNorm"
CROSS_DOC_ATTN_FLAGS="--reset-attention-mask --reset-position-ids"
EOD_LOSS_MASK_FLAG="--eod-mask-loss"

# Data, tokenizer, loss, order, and validation are all bridge/recipe-owned.
BASE_TOKENIZER_DIR="$FULL_CPT_TOKENIZER_DIR"
EXT_TOKENIZER_DIR="$FULL_CPT_TOKENIZER_DIR"
BASE_DATA_PREFIX="$FULL_CPT_DATA_PREFIX"
EXT_DATA_PREFIX="$FULL_CPT_DATA_PREFIX"
LOSS_OBJECTIVE="goldfish"
GOLDFISH_K="50"
GOLDFISH_H="50"
CURRICULUM_ORDER_MODE="physical_order"
DATA_SEED="20260609"
DATALOADER_WORKERS="4"
USE_MOCK_DATA="0"
ENABLE_EXTRA_VALID="1"

# Exact training horizon and cadence. EXIT_INTERVAL is segment-owned, but its
# expected value is exported by the receipt-validating launcher and asserted at
# job start. Resume mode is derived from the verified start boundary only.
TRAIN_TOKENS="25000000000"
SAVE_INTERVAL="119"
EVAL_INTERVAL="25"
EVAL_ITERS="1"
EXIT_INTERVAL="${FULL_CPT_VERIFY_EXPECTED_EXIT_INTERVAL:-}"
RESUME_TRAINING="0"
full_cpt_start_iteration="${FULL_CPT_VERIFY_START_ITERATION:-0}"
if [[ "$full_cpt_start_iteration" =~ ^[0-9]+$ ]] \
    && (( full_cpt_start_iteration > 0 )); then
    RESUME_TRAINING="1"
fi
unset full_cpt_start_iteration
DISABLE_SAVE="0"
USE_DISTRIBUTED_OPTIMIZER="1"
USE_COMM_OVERLAP="1"
unset DDP_BUCKET_SIZE TRAINER_WRAPPER MEGATRON_GPT_DATASET_NO_SHUFFLE

# Frozen Clariden launch geometry. Slurm's own variables and transport/debug
# knobs remain inherited; these recipe values cannot be inherited or swept.
ACCOUNT="a0140"
PARTITION="normal"
NODES="16"
GPUS_PER_NODE="4"
TIME_LIMIT="06:00:00"
LAUNCH_MODE="torchrun"

# Recompute every derived horizon after all common defaults are overwritten.
TRAIN_SAMPLES="$(( TRAIN_TOKENS / SEQ_LENGTH ))"
TRAIN_ITERS="$(( TRAIN_SAMPLES / GLOBAL_BATCH_SIZE ))"
LR_WARMUP_TOKENS="$(( LR_WARMUP_ITERS * GLOBAL_BATCH_TOKENS ))"
LR_WSD_DECAY_SAMPLES="$(( TRAIN_SAMPLES / 5 ))"
ADEMA_BETA3_WARMUP_STEPS="$TRAIN_ITERS"
ADEMA_ALPHA_WARMUP_STEPS="$TRAIN_ITERS"

# A second, post-source assertion in bakeoff_train.sbatch checks this complete
# effective contract. This makes inherited --export=ALL values harmless while
# preserving legacy bakeoff behavior for configs that do not opt into it.
FULL_CPT_FROZEN_RECIPE_CONTRACT=(
    "ARM=td"
    "ARM_NAME=full_corpus_td_25b_79_20_1"
    "UENV_IMAGE=pytorch/v2.9.1:v2"
    "ADEMA_BETA1=0.9"
    "ADEMA_BETA2=0.999"
    "ADEMA_BETA3=0.999"
    "ADEMA_ALPHA=4.0"
    "ADEMA_WEIGHT_DECAY=0.1"
    "ADEMA_BETA_START=0.9"
    "GRAD_CLIP=0.1"
    "INIT_STD=0.008944"
    "LR_PEAK=5.5e-5"
    "LR_FINAL=5.5e-6"
    "LR_WARMUP_INIT=5.5e-6"
    "LR_SCHEDULE_STYLE=WSD"
    "LR_DECAY_STYLE=1-sqrt"
    "LR_WARMUP_ITERS=400"
    "SEQ_LENGTH=4096"
    "SEQ_LEN=4096"
    "MAX_POSITION_EMBEDDINGS=4096"
    "ROTARY_BASE=500000"
    "USE_ROPE_SCALING=1"
    "ROPE_SCALING_FACTOR=8.0"
    "MAKE_VOCAB_SIZE_DIVISIBLE_BY=256"
    "MICROBATCH_SIZE=2"
    "GLOBAL_BATCH_SIZE=1024"
    "GLOBAL_BATCH_TOKENS=4194304"
    "MIXED_PRECISION_FLAG=--bf16"
    "MAIN_GRADS_DTYPE=fp32"
    "TENSOR_MODEL_PARALLEL_SIZE=2"
    "PIPELINE_MODEL_PARALLEL_SIZE=1"
    "ACTIVATION_FLAG=--xielu"
    "XIELU_INIT_AP=0.8"
    "XIELU_INIT_AN=0.8"
    "QK_LAYERNORM_FLAG=--qk-layernorm"
    "QKNORM_IMPL=apex"
    "NORMALIZATION=RMSNorm"
    "CROSS_DOC_ATTN_FLAGS=--reset-attention-mask --reset-position-ids"
    "EOD_LOSS_MASK_FLAG=--eod-mask-loss"
    "FULL_CPT_TOKENIZER_DIR=$FULL_CPT_TOKENIZER_DIR"
    "BASE_TOKENIZER_DIR=$FULL_CPT_TOKENIZER_DIR"
    "EXT_TOKENIZER_DIR=$FULL_CPT_TOKENIZER_DIR"
    "FULL_CPT_DATA_PREFIX=$FULL_CPT_DATA_PREFIX"
    "BASE_DATA_PREFIX=$FULL_CPT_DATA_PREFIX"
    "EXT_DATA_PREFIX=$FULL_CPT_DATA_PREFIX"
    "LOSS_OBJECTIVE=goldfish"
    "GOLDFISH_K=50"
    "GOLDFISH_H=50"
    "CURRICULUM_ORDER_MODE=physical_order"
    "DATA_SEED=20260609"
    "DATALOADER_WORKERS=4"
    "USE_MOCK_DATA=0"
    "ENABLE_EXTRA_VALID=1"
    "VAL_DATA_DIR=$VAL_DATA_DIR"
    "EXTRA_VALID_SETS=$EXTRA_VALID_SETS"
    "TRAIN_TOKENS=25000000000"
    "TRAIN_SAMPLES=6103515"
    "TRAIN_ITERS=5960"
    "LR_WARMUP_TOKENS=1677721600"
    "LR_WSD_DECAY_SAMPLES=1220703"
    "ADEMA_BETA3_WARMUP_STEPS=5960"
    "ADEMA_ALPHA_WARMUP_STEPS=5960"
    "SAVE_INTERVAL=119"
    "EVAL_INTERVAL=25"
    "EVAL_ITERS=1"
    "EXIT_INTERVAL=$EXIT_INTERVAL"
    "RESUME_TRAINING=$RESUME_TRAINING"
    "DISABLE_SAVE=0"
    "USE_DISTRIBUTED_OPTIMIZER=1"
    "USE_COMM_OVERLAP=1"
    "ACCOUNT=a0140"
    "PARTITION=normal"
    "NODES=16"
    "GPUS_PER_NODE=4"
    "TIME_LIMIT=06:00:00"
    "LAUNCH_MODE=torchrun"
)
FULL_CPT_FROZEN_UNSET_VARIABLES=(
    DDP_BUCKET_SIZE
    TRAINER_WRAPPER
    MEGATRON_GPT_DATASET_NO_SHUFFLE
)

full_cpt_assert_frozen_recipe() {
    local binding name expected
    for binding in "${FULL_CPT_FROZEN_RECIPE_CONTRACT[@]}"; do
        name="${binding%%=*}"
        expected="${binding#*=}"
        if [[ "${!name-}" != "$expected" ]]; then
            echo "ERROR: frozen full-corpus recipe drift for $name: expected '$expected', got '${!name-}'" >&2
            return 10
        fi
    done
    for name in "${FULL_CPT_FROZEN_UNSET_VARIABLES[@]}"; do
        if [[ -v $name ]]; then
            echo "ERROR: frozen full-corpus recipe requires $name to be unset" >&2
            return 10
        fi
    done
}

export FULL_CPT_BRIDGE_MANIFEST FULL_CPT_INPUT_RECEIPT FULL_CPT_HELDOUT_MANIFEST FULL_CPT_MIX_RECIPE
