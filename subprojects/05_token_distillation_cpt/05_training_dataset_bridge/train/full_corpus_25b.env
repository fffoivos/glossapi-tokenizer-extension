# Frozen 25B full-corpus TD probe. This is a single continuous 79/20/1 blend,
# not the historical 13.5B two-phase curriculum sweep.
FULL_CPT_REQUIRE_JOB_START_VERIFY="1"
: "${BRIDGE_DATA_ENV:?set BRIDGE_DATA_ENV to the finalized training_data.env}"
test -s "$BRIDGE_DATA_ENV" || { echo "ERROR: bridge data env missing: $BRIDGE_DATA_ENV" >&2; return 2; }

# Set horizon-dependent values before common_cpt.env derives samples/steps.
TRAIN_TOKENS="25000000000"
LR_WARMUP_ITERS="400"
LR_PEAK="5.5e-5"
LR_FINAL="5.5e-6"
ADEMA_BETA2="0.999"
ADEMA_BETA3="0.999"
ADEMA_ALPHA="4.0"

THIS_CONFIG_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
FULL_CPT_EFFECTIVE_COMMON_TRAINING_ENV="$(cd "$THIS_CONFIG_DIR/../../03_training_experiments/configs" && pwd)/common_cpt.env"
source "$FULL_CPT_EFFECTIVE_COMMON_TRAINING_ENV"
source "$BRIDGE_DATA_ENV"

ARM_NAME="full_corpus_td_25b_79_20_1"
: "${INIT_CKPT:?the receipt-validating launcher must supply INIT_CKPT}"
EXT_TOKENIZER_DIR="$FULL_CPT_TOKENIZER_DIR"
BASE_TOKENIZER_DIR="$FULL_CPT_TOKENIZER_DIR"
EXT_DATA_PREFIX="$FULL_CPT_DATA_PREFIX"
BASE_DATA_PREFIX="$FULL_CPT_DATA_PREFIX"
CURRICULUM_ORDER_MODE="physical_order"
LOSS_OBJECTIVE="goldfish"
GOLDFISH_K="50"
GOLDFISH_H="50"
SEQ_LENGTH="4096"
MAX_POSITION_EMBEDDINGS="4096"
ROTARY_BASE="500000"
GLOBAL_BATCH_SIZE="1024"
GLOBAL_BATCH_TOKENS="4194304"

# Recompute explicitly to make accidental 13.5B inheritance impossible.
SEQ_LEN="$SEQ_LENGTH"
TRAIN_SAMPLES="$(( TRAIN_TOKENS / SEQ_LENGTH ))"
TRAIN_ITERS="$(( TRAIN_SAMPLES / GLOBAL_BATCH_SIZE ))"
LR_WARMUP_TOKENS="$(( LR_WARMUP_ITERS * GLOBAL_BATCH_TOKENS ))"
LR_WSD_DECAY_SAMPLES="$(( TRAIN_SAMPLES / 5 ))"
ADEMA_BETA3_WARMUP_STEPS="$TRAIN_ITERS"
ADEMA_ALPHA_WARMUP_STEPS="$TRAIN_ITERS"

export FULL_CPT_BRIDGE_MANIFEST FULL_CPT_INPUT_RECEIPT FULL_CPT_HELDOUT_MANIFEST FULL_CPT_MIX_RECIPE
