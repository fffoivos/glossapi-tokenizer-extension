# Non-secret Clariden defaults for the receipt-bound training bridge.
BRIDGE_ACCOUNT="${BRIDGE_ACCOUNT:-a0140}"
BRIDGE_PARTITION="${BRIDGE_PARTITION:-normal}"
BRIDGE_UENV="${BRIDGE_UENV:-pytorch/v2.9.1:v2}"

SCRATCH_ROOT="${SCRATCH_ROOT:-/iopsstor/scratch/cscs/fffoivos}"
REPO_ROOT="${REPO_ROOT:-$SCRATCH_ROOT/repo/train-apertus-with-glossapi}"
BRIDGE_DIR="${BRIDGE_DIR:-$REPO_ROOT/subprojects/05_token_distillation_cpt/05_training_dataset_bridge}"
BRIDGE_CONFIG="${BRIDGE_CONFIG:-$BRIDGE_DIR/configs/frozen_25b_td.json}"
REPLAY_ACQUISITION_CONFIG="${REPLAY_ACQUISITION_CONFIG:-$BRIDGE_DIR/configs/replay_acquisition.json}"
BRIDGE_RUN_ID="${BRIDGE_RUN_ID:-}"
BRIDGE_STAGE_ROOT="${BRIDGE_STAGE_ROOT:-}"
if [[ -n "$BRIDGE_RUN_ID" && -z "$BRIDGE_STAGE_ROOT" ]]; then
    BRIDGE_STAGE_ROOT="$SCRATCH_ROOT/cpt_corpus/training_bridge/$BRIDGE_RUN_ID"
fi
BRIDGE_RUN_ROOT="${BRIDGE_RUN_ROOT:-/capstor/scratch/cscs/fffoivos/runs/05_token_distillation_cpt/training_bridge/${BRIDGE_RUN_ID:-unset}}"

# Must be the completed Phase-04 `stages/80-materialize-validate` directory.
PHASE04_STAGE="${PHASE04_STAGE:-}"
TOKENIZER_DIR="${TOKENIZER_DIR:-$SCRATCH_ROOT/tokenizers/apertus_greek_modern_only_148480}"
MEGATRON_DIR="${MEGATRON_DIR:-$SCRATCH_ROOT/code/training/Megatron-LM-Swiss-AI}"
RUNTIME_VENV="${RUNTIME_VENV:-$SCRATCH_ROOT/python_envs/full_corpus_v2}"

INPUT_RECEIPT="${INPUT_RECEIPT:-${BRIDGE_STAGE_ROOT:+$BRIDGE_STAGE_ROOT/input_receipt.json}}"
HELDOUT_MANIFEST="${HELDOUT_MANIFEST:-${BRIDGE_STAGE_ROOT:+$BRIDGE_STAGE_ROOT/heldouts/heldout_manifest.json}}"
BRIDGE_MANIFEST="${BRIDGE_MANIFEST:-${BRIDGE_STAGE_ROOT:+$BRIDGE_STAGE_ROOT/bridge_manifest.json}}"
TRAINING_ASSETS_RECEIPT="${TRAINING_ASSETS_RECEIPT:-${BRIDGE_STAGE_ROOT:+$BRIDGE_STAGE_ROOT/training_assets_receipt.json}}"
REPLAY_ACQUISITION_RECEIPT="${REPLAY_ACQUISITION_RECEIPT:-${BRIDGE_STAGE_ROOT:+$BRIDGE_STAGE_ROOT/replay_acquisition_receipt.json}}"
OLD_GREEK_BUILD_RECEIPT="${OLD_GREEK_BUILD_RECEIPT:-${BRIDGE_STAGE_ROOT:+$BRIDGE_STAGE_ROOT/old_greek_build_receipt.json}}"
REPLAY_HF_CACHE="${REPLAY_HF_CACHE:-$SCRATCH_ROOT/hf_cache/phase05_replay_acquisition}"

ACQUIRE_SCRIPT="$BRIDGE_DIR/scripts/acquire_replay_sources.py"
OLD_GREEK_BUILD_SCRIPT="$BRIDGE_DIR/scripts/build_old_greek_replay.py"
FREEZE_SCRIPT="$BRIDGE_DIR/scripts/freeze_inputs.py"
HELDOUT_SCRIPT="$BRIDGE_DIR/scripts/build_heldouts.py"
BINARY_SCRIPT="$BRIDGE_DIR/scripts/build_binary_shard.py"
FINALIZE_SCRIPT="$BRIDGE_DIR/scripts/finalize_bridge.py"
TRAINING_ASSETS_SCRIPT="$BRIDGE_DIR/scripts/freeze_training_assets.py"
RESUME_CHECKPOINT_SCRIPT="$BRIDGE_DIR/scripts/freeze_resume_checkpoint.py"
TRAIN_DIR="${TRAIN_DIR:-$REPO_ROOT/subprojects/03_apertus_extension_and_embedding_adaptation/03_4_implementation_experiments/init_bakeoff/bakeoff_training}"
TRAIN_SCRIPT="${TRAIN_SCRIPT:-$TRAIN_DIR/bakeoff_train.sbatch}"
TRAINING_ENV="${TRAINING_ENV:-$BRIDGE_DIR/train/full_corpus_25b.env}"

bridge_require_base() {
    : "${BRIDGE_RUN_ID:?set one immutable BRIDGE_RUN_ID for this build}"
    : "${BRIDGE_STAGE_ROOT:?BRIDGE_STAGE_ROOT did not resolve}"
    test -x "$RUNTIME_VENV/bin/python" || { echo "ERROR: runtime missing: $RUNTIME_VENV" >&2; return 2; }
    test -f "$BRIDGE_CONFIG" || { echo "ERROR: config missing: $BRIDGE_CONFIG" >&2; return 2; }
    test -f "$REPLAY_ACQUISITION_CONFIG" || { echo "ERROR: acquisition config missing: $REPLAY_ACQUISITION_CONFIG" >&2; return 2; }
}

bridge_require_paths() {
    bridge_require_base
    : "${PHASE04_STAGE:?set PHASE04_STAGE to Phase-04 stages/80-materialize-validate}"
}

bridge_python() {
    uenv run "$BRIDGE_UENV" --view=default -- "$RUNTIME_VENV/bin/python" "$@"
}
