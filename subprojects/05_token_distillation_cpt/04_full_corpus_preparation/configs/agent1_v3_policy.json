{
  "schema_version": "agent1_full_corpus_v3_policy_v1",
  "review": {
    "seed": "greek-apertus-agent1-full-corpus-v3-source-review-v1",
    "model_environment_variable": "CODEX_REVIEW_MODEL",
    "required_model": "gpt-5.6-luna",
    "reasoning_effort": "low",
    "minimum_documents_per_eligible_source": 100,
    "sample_strata": {
      "random": 60,
      "risk": 20,
      "cluster": 20
    },
    "large_or_heterogeneous_total": 200,
    "large_or_heterogeneous_source_ids": [
      "diavgeia",
      "amna_press",
      "ellakv2",
      "eellak_articles",
      "openarchives_current"
    ],
    "double_review_fraction": 0.1,
    "review_copy": "mask_high_confidence_direct_identifiers_preserve_position_and_original_hash",
    "no_model_fallback": true
  },
  "dedup": {
    "exact_identity_order": [
      "content",
      "work",
      "representation"
    ],
    "near": {
      "token_shingle_size": 5,
      "minhash_permutations": 128,
      "bands": 32,
      "rows_per_band": 4,
      "similarity_threshold": 0.85,
      "oversized_bucket_ceiling": 5000,
      "greek_diacritic_policy": "preserve"
    },
    "representative_precedence": [
      "nanochat_base",
      "license",
      "extraction_completeness",
      "quality",
      "provenance",
      "stable_id"
    ]
  },
  "greekmmlu": {
    "policy": "high_confidence_exact_or_aligned_question_answer_only",
    "ambiguity": "quarantine_and_stop"
  },
  "anonymization": {
    "drop_private_data_true": true,
    "mask_types": [
      "email",
      "phone",
      "afm",
      "amka",
      "iban",
      "identity_or_passport",
      "ip"
    ],
    "generic_person_name_ner": false,
    "street_address_policy": "precision_gated_not_enabled",
    "preserve_legal_citations": true,
    "diavgeia_personnel_table": "quarantine_when_pii_heavy"
  },
  "structural": {
    "default": "no_op",
    "requires_agent2_immutable_handoff": true,
    "allowlisted_profiles": [
      "academic_ocr",
      "academic_sectioned"
    ]
  }
}
