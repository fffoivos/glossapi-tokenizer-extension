#!/usr/bin/env bash
# Non-secret paths for the isolated Agent 1 v4 raw-review lane.
#
# This lane is intentionally separate from agent1_v3_*; it samples raw source
# representations before any canonicalization or GlossAPI processing.

AGENT1_V4_ACCOUNT="${AGENT1_V4_ACCOUNT:-a0140}"
AGENT1_V4_PARTITION="${AGENT1_V4_PARTITION:-normal}"
AGENT1_V4_UENV="${AGENT1_V4_UENV:-pytorch/v2.9.1:v2}"

REPO_ROOT="${REPO_ROOT:-/iopsstor/scratch/cscs/fffoivos/repo/train-apertus-with-glossapi}"
PHASE04_DIR="${PHASE04_DIR:-$REPO_ROOT/subprojects/05_token_distillation_cpt/04_full_corpus_preparation}"
AGENT1_V4_CLARIDEN_DIR="${AGENT1_V4_CLARIDEN_DIR:-$PHASE04_DIR/clariden}"

AGENT1_V4_RUNS_ROOT="${AGENT1_V4_RUNS_ROOT:-/iopsstor/scratch/cscs/fffoivos/apertus-c3-prep-v4}"
AGENT1_V4_RUN_ID="${AGENT1_V4_RUN_ID:-}"
AGENT1_V4_RUN_ROOT="${AGENT1_V4_RUN_ROOT:-}"
AGENT1_V4_RUNTIME_VENV="${AGENT1_V4_RUNTIME_VENV:-}"

AGENT1_V4_SOURCES="${AGENT1_V4_SOURCES:-$PHASE04_DIR/configs/sources.json}"
AGENT1_V4_ROSTER="${AGENT1_V4_ROSTER:-$PHASE04_DIR/configs/agent1_v3_candidate_roster.json}"
AGENT1_V4_POLICY="${AGENT1_V4_POLICY:-$PHASE04_DIR/configs/agent1_v4_raw_review_policy.json}"
AGENT1_V4_LICENSE_ADJUDICATION="${AGENT1_V4_LICENSE_ADJUDICATION:-$PHASE04_DIR/configs/source_license_adjudication.json}"
AGENT1_V4_NANOCHAT_ROSTER="${AGENT1_V4_NANOCHAT_ROSTER:-$PHASE04_DIR/configs/nanochat_initial_roster.json}"
AGENT1_V4_PROMPT="${AGENT1_V4_PROMPT:-$PHASE04_DIR/configs/agent1_v4_terra_review_prompt.md}"
AGENT1_V4_RESPONSE_SCHEMA="${AGENT1_V4_RESPONSE_SCHEMA:-$PHASE04_DIR/schemas/agent1_v4_terra_review_response.schema.json}"
AGENT1_V4_ENVIRONMENT_LOCK="${AGENT1_V4_ENVIRONMENT_LOCK:-$PHASE04_DIR/requirements-runtime.txt}"
AGENT1_V4_FREEZER="${AGENT1_V4_FREEZER:-$PHASE04_DIR/scripts/freeze_agent1_v4_review.py}"
AGENT1_V4_PACKET_EXPORTER="${AGENT1_V4_PACKET_EXPORTER:-$PHASE04_DIR/scripts/export_agent1_v4_raw_review_packet.py}"
AGENT1_V4_RESPONSE_VALIDATOR="${AGENT1_V4_RESPONSE_VALIDATOR:-$PHASE04_DIR/scripts/validate_agent1_v4_terra_responses.py}"
AGENT1_V4_SITE_BUILDER="${AGENT1_V4_SITE_BUILDER:-$PHASE04_DIR/scripts/build_agent1_v4_review_site.py}"
AGENT1_V4_HUMAN_GATE="${AGENT1_V4_HUMAN_GATE:-$PHASE04_DIR/scripts/validate_agent1_v4_human_decisions.py}"
AGENT1_V4_FIELD_PROFILER="${AGENT1_V4_FIELD_PROFILER:-$PHASE04_DIR/scripts/profile_agent1_v4_fields.py}"
AGENT1_V4_ENVELOPE_MATERIALIZER="${AGENT1_V4_ENVELOPE_MATERIALIZER:-$PHASE04_DIR/scripts/materialize_agent1_v4_nanochat_envelope.py}"
AGENT1_V4_GLOSSAPI_COMMIT="${AGENT1_V4_GLOSSAPI_COMMIT:-6f29a2825559c540ab342fc77ae4457cf3556f2a}"
AGENT1_V4_GREEKMMLU_REGISTRY="${AGENT1_V4_GREEKMMLU_REGISTRY:-$REPO_ROOT/subprojects/03_apertus_extension_and_embedding_adaptation/03_4_implementation_experiments/init_bakeoff/eval/native_greek_benchmark_registry.json}"

# This is a previously passed receipt.  v4 never acquires arbitrary paths.
AGENT1_V4_ACQUISITION_RECEIPT="${AGENT1_V4_ACQUISITION_RECEIPT:-}"
AGENT1_V4_HUMAN_DECISIONS="${AGENT1_V4_HUMAN_DECISIONS:-}"
AGENT1_V4_FIELD_MAPPING="${AGENT1_V4_FIELD_MAPPING:-}"
