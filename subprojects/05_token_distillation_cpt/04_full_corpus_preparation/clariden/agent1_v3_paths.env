# Non-secret defaults for the isolated Agent 1 v3 lane.  Do not source the v2
# paths.env from a v3 job: its output roots and stage order are intentionally
# incompatible with this lane.

AGENT1_V3_ACCOUNT="${AGENT1_V3_ACCOUNT:-a0140}"
AGENT1_V3_PARTITION="${AGENT1_V3_PARTITION:-normal}"
AGENT1_V3_UENV="${AGENT1_V3_UENV:-pytorch/v2.9.1:v2}"

REPO_ROOT="${REPO_ROOT:-/iopsstor/scratch/cscs/fffoivos/repo/train-apertus-with-glossapi}"
PHASE04_DIR="${PHASE04_DIR:-$REPO_ROOT/subprojects/05_token_distillation_cpt/04_full_corpus_preparation}"
AGENT1_V3_CLARIDEN_DIR="${AGENT1_V3_CLARIDEN_DIR:-$PHASE04_DIR/clariden}"
AGENT1_V3_CONTRACT_SCRIPT="${AGENT1_V3_CONTRACT_SCRIPT:-$PHASE04_DIR/scripts/agent1_v3_contract.py}"

AGENT1_V3_RUNS_ROOT="${AGENT1_V3_RUNS_ROOT:-/capstor/scratch/cscs/fffoivos/runs/05_token_distillation_cpt/full_corpus_v3/agent1_pipeline_runs}"
AGENT1_V3_DATA_ROOT_BASE="${AGENT1_V3_DATA_ROOT_BASE:-/iopsstor/scratch/cscs/fffoivos/cpt_corpus/full_corpus_v3/agent1}"
AGENT1_V3_HF_EXISTING_DESTINATION="${AGENT1_V3_HF_EXISTING_DESTINATION:-/iopsstor/scratch/cscs/fffoivos/cpt_corpus/full_corpus_v2/hf}"
# The receipt merger only reads trusted payload paths.  This common ancestor
# covers the retained v2 HF bytes and the new v3 MDC bytes without copying the
# 158-GiB payload into a second location.
AGENT1_V3_RAW_COMMON_ROOT="${AGENT1_V3_RAW_COMMON_ROOT:-/iopsstor/scratch/cscs/fffoivos/cpt_corpus}"

AGENT1_V3_RUN_ID="${AGENT1_V3_RUN_ID:-}"
AGENT1_V3_RUN_ROOT="${AGENT1_V3_RUN_ROOT:-}"
AGENT1_V3_DATA_ROOT="${AGENT1_V3_DATA_ROOT:-}"
AGENT1_V3_RUNTIME_VENV="${AGENT1_V3_RUNTIME_VENV:-}"

AGENT1_V3_SOURCE_CONFIG="${AGENT1_V3_SOURCE_CONFIG:-$PHASE04_DIR/configs/sources.json}"
AGENT1_V3_SOURCE_ALIASES="${AGENT1_V3_SOURCE_ALIASES:-$PHASE04_DIR/configs/source_lineage_aliases.json}"
AGENT1_V3_CANDIDATE_ROSTER="${AGENT1_V3_CANDIDATE_ROSTER:-$PHASE04_DIR/configs/agent1_v3_candidate_roster.json}"
AGENT1_V3_POST_CUTOFF_INVENTORY="${AGENT1_V3_POST_CUTOFF_INVENTORY:-$PHASE04_DIR/configs/post_december_inventory.json}"
AGENT1_V3_NANOCHAT_INITIAL_ROSTER="${AGENT1_V3_NANOCHAT_INITIAL_ROSTER:-$PHASE04_DIR/configs/nanochat_initial_roster.json}"
AGENT1_V3_POLICY="${AGENT1_V3_POLICY:-$PHASE04_DIR/configs/agent1_v3_policy.json}"
AGENT1_V3_REVIEW_POLICY="${AGENT1_V3_REVIEW_POLICY:-$PHASE04_DIR/configs/agent1_v3_policy.json}"
AGENT1_V3_REVIEW_PROMPT="${AGENT1_V3_REVIEW_PROMPT:-$PHASE04_DIR/configs/agent1_v3_codex_review_prompt.md}"
AGENT1_V3_REVIEW_RESPONSE_SCHEMA="${AGENT1_V3_REVIEW_RESPONSE_SCHEMA:-$PHASE04_DIR/schemas/agent1_v3_review_response.schema.json}"
AGENT1_V3_LICENSE_ADJUDICATION="${AGENT1_V3_LICENSE_ADJUDICATION:-$PHASE04_DIR/configs/source_license_adjudication.json}"
AGENT1_V3_ELIGIBILITY_POLICY="${AGENT1_V3_ELIGIBILITY_POLICY:-$PHASE04_DIR/configs/training_eligibility_policy.json}"

AGENT1_V3_TOKENIZER_REVISION="${AGENT1_V3_TOKENIZER_REVISION:-a4826df7f76b54cdd6dc21d09fe97283c466999b}"
AGENT1_V3_TOKENIZER_JSON="${AGENT1_V3_TOKENIZER_JSON:-/iopsstor/scratch/cscs/fffoivos/cpt_corpus/full_corpus_v2/hf/modern_greek_148k_tokenizer/$AGENT1_V3_TOKENIZER_REVISION/greek-extension-tokenizer/tokenizer.json}"

AGENT1_V3_GLOSSAPI_COMMIT="${AGENT1_V3_GLOSSAPI_COMMIT:-6f29a2825559c540ab342fc77ae4457cf3556f2a}"
AGENT1_V3_GLOSSAPI_ROOT="${AGENT1_V3_GLOSSAPI_ROOT:-/iopsstor/scratch/cscs/fffoivos/repo/glossAPI-quality-$AGENT1_V3_GLOSSAPI_COMMIT}"
