# Non-secret Clariden defaults. Override any path in the submission environment.
PHASE04_ACCOUNT="${PHASE04_ACCOUNT:-a0140}"
PHASE04_PARTITION="${PHASE04_PARTITION:-normal}"
PHASE04_UENV="${PHASE04_UENV:-pytorch/v2.9.1:v2}"

REPO_ROOT="${REPO_ROOT:-/iopsstor/scratch/cscs/fffoivos/repo/train-apertus-with-glossapi}"
PHASE04_DIR="${PHASE04_DIR:-$REPO_ROOT/subprojects/05_token_distillation_cpt/04_full_corpus_preparation}"
ACADEMIC_DIR="${ACADEMIC_DIR:-$REPO_ROOT/subprojects/05_token_distillation_cpt/02_corpus_preparation/15_clean_academic}"
RUNTIME_VENV="${RUNTIME_VENV:-/iopsstor/scratch/cscs/fffoivos/python_envs/full_corpus_v2}"

DATA_ROOT="${DATA_ROOT:-/iopsstor/scratch/cscs/fffoivos/cpt_corpus/full_corpus_v2}"
RUN_ROOT="${RUN_ROOT:-/capstor/scratch/cscs/fffoivos/runs/05_token_distillation_cpt/full_corpus_v2}"
PIPELINE_RUNS_ROOT="${PIPELINE_RUNS_ROOT:-$RUN_ROOT/pipeline_runs}"
# Required for every post-acquisition production stage.  It is deliberately not
# timestamped here: the operator chooses one immutable ID and reuses it for
# status/resume.  common.sh rejects a run root that is not exactly beneath
# PIPELINE_RUNS_ROOT.
PIPELINE_RUN_ID="${PIPELINE_RUN_ID:-}"
PIPELINE_RUN_ROOT="${PIPELINE_RUN_ROOT:-}"
TOKENIZER_REVISION="${TOKENIZER_REVISION:-a4826df7f76b54cdd6dc21d09fe97283c466999b}"
TOKENIZER_JSON="${TOKENIZER_JSON:-$DATA_ROOT/hf/modern_greek_148k_tokenizer/$TOKENIZER_REVISION/greek-extension-tokenizer/tokenizer.json}"
TOKENIZER_SHA256="${TOKENIZER_SHA256:-358ae3f29ac17c99769d6d437339e28657d5fcaed3486f8550feed3d6adfc394}"

SOURCE_CONFIG="${SOURCE_CONFIG:-$PHASE04_DIR/configs/sources.json}"
SOURCE_LICENSE_ADJUDICATION="${SOURCE_LICENSE_ADJUDICATION:-$PHASE04_DIR/configs/source_license_adjudication.json}"
CLEANING_POLICY="${CLEANING_POLICY:-$PHASE04_DIR/configs/cleaning_policy.json}"
# Script entry points are centralized because normalization/cleaning/release
# implementation is landing in parallel.  Override only during a reviewed
# handoff; receipts bind the exact repository commit used by the job.
NORMALIZE_SCRIPT="${NORMALIZE_SCRIPT:-$PHASE04_DIR/scripts/normalize_sources.py}"
LINEAGE_SCRIPT="${LINEAGE_SCRIPT:-$PHASE04_DIR/scripts/build_source_lineage.py}"
APERTUS_OVERLAP_ACTIONS_SCRIPT="${APERTUS_OVERLAP_ACTIONS_SCRIPT:-$PHASE04_DIR/scripts/build_apertus_overlap_actions.py}"
REVIEW_PACKET_SCRIPT="${REVIEW_PACKET_SCRIPT:-$PHASE04_DIR/scripts/build_source_review_packet.py}"
REVIEW_AGGREGATE_SCRIPT="${REVIEW_AGGREGATE_SCRIPT:-$PHASE04_DIR/scripts/aggregate_source_reviews.py}"
DATASET_QUALITY_SCRIPT="${DATASET_QUALITY_SCRIPT:-$PHASE04_DIR/scripts/profile_dataset_quality_rust.py}"
DATASET_REVIEW_SAMPLE_EXPORT_SCRIPT="${DATASET_REVIEW_SAMPLE_EXPORT_SCRIPT:-$PHASE04_DIR/scripts/export_dataset_review_samples.py}"
MERGE_ADMISSIONS_SCRIPT="${MERGE_ADMISSIONS_SCRIPT:-$PHASE04_DIR/scripts/merge_source_admissions.py}"
CLEAN_SCRIPT="${CLEAN_SCRIPT:-$PHASE04_DIR/scripts/apply_cleaning_policy.py}"
FINALIZE_CLEAN_SCRIPT="${FINALIZE_CLEAN_SCRIPT:-$PHASE04_DIR/scripts/finalize_structural_cleaning.py}"
STRUCTURAL_SPAN_PRODUCTION_SCRIPT="${STRUCTURAL_SPAN_PRODUCTION_SCRIPT:-$PHASE04_DIR/scripts/structural_span_production.py}"
DECONTAM_SCRIPT="${DECONTAM_SCRIPT:-$PHASE04_DIR/scripts/decontaminate_full_corpus.py}"
DEDUP_WRAPPER_SCRIPT="${DEDUP_WRAPPER_SCRIPT:-$PHASE04_DIR/scripts/run_full_corpus_dedup.py}"
MATERIALIZE_SCRIPT="${MATERIALIZE_SCRIPT:-$PHASE04_DIR/scripts/materialize_release.py}"
VALIDATE_RELEASE_SCRIPT="${VALIDATE_RELEASE_SCRIPT:-$PHASE04_DIR/scripts/validate_release.py}"
PUBLISH_RELEASE_SCRIPT="${PUBLISH_RELEASE_SCRIPT:-$PHASE04_DIR/scripts/publish_release.py}"

SOURCE_REVIEW_POLICY="${SOURCE_REVIEW_POLICY:-$PHASE04_DIR/configs/source_review_policy.json}"
POST_DECEMBER_INVENTORY="${POST_DECEMBER_INVENTORY:-$PHASE04_DIR/configs/post_december_inventory.json}"
TRAINING_ELIGIBILITY_POLICY="${TRAINING_ELIGIBILITY_POLICY:-$PHASE04_DIR/configs/training_eligibility_policy.json}"
GREEKMMLU_QUERIES_JSONL="${GREEKMMLU_QUERIES_JSONL:-}"
GREEKMMLU_BENCHMARK_MANIFEST="${GREEKMMLU_BENCHMARK_MANIFEST:-}"
HF_REPO_ID="${HF_REPO_ID:-fffoivos/glossapi-greek-cpt-redistributable-delta-v2}"
# Structural jobs must point this at a job-unique published detector build.
REFERENCE_BIN="${REFERENCE_BIN:-}"
DETECTOR_BUILD_RECEIPT="${DETECTOR_BUILD_RECEIPT:-}"
STRUCTURAL_PARITY_RECEIPT="${STRUCTURAL_PARITY_RECEIPT:-}"
STRUCTURAL_BIB_MODEL="${STRUCTURAL_BIB_MODEL:-$ACADEMIC_DIR/eval/span_line_lr_struct_model.json}"
STRUCTURAL_TOC_MODEL="${STRUCTURAL_TOC_MODEL:-$ACADEMIC_DIR/eval/toc_line_lr_model.json}"
STRUCTURAL_SMOOTHER="${STRUCTURAL_SMOOTHER:-$ACADEMIC_DIR/eval/struct_smooth_params.json}"
STRUCTURAL_SEQUENCE_CONFIG="${STRUCTURAL_SEQUENCE_CONFIG:-$ACADEMIC_DIR/eval/sequence_models/config.json}"
STRUCTURAL_BIB_RUST_CODE="${STRUCTURAL_BIB_RUST_CODE:-$ACADEMIC_DIR/reference_detector/src/span_line_model.rs}"
STRUCTURAL_TOC_RUST_CODE="${STRUCTURAL_TOC_RUST_CODE:-$ACADEMIC_DIR/reference_detector/src/toc_line_model.rs}"

# Built separately from a clean detached checkout at this exact commit.  The
# profiling job validates both the checkout and imported PyO3 module hashes
# against GLOSSAPI_RUST_QUALITY_BUILD_RECEIPT before reading corpus text.
GLOSSAPI_QUALITY_COMMIT="${GLOSSAPI_QUALITY_COMMIT:-6f29a2825559c540ab342fc77ae4457cf3556f2a}"
GLOSSAPI_QUALITY_ROOT="${GLOSSAPI_QUALITY_ROOT:-/iopsstor/scratch/cscs/fffoivos/repo/glossAPI-quality-$GLOSSAPI_QUALITY_COMMIT}"
GLOSSAPI_QUALITY_RUNTIME_ROOT="${GLOSSAPI_QUALITY_RUNTIME_ROOT:-$DATA_ROOT/runtime/glossapi-rust-quality-$GLOSSAPI_QUALITY_COMMIT}"
GLOSSAPI_QUALITY_MODULE_DIR="${GLOSSAPI_QUALITY_MODULE_DIR:-$GLOSSAPI_QUALITY_RUNTIME_ROOT/modules}"
GLOSSAPI_RUST_QUALITY_BUILD_RECEIPT="${GLOSSAPI_RUST_QUALITY_BUILD_RECEIPT:-$GLOSSAPI_QUALITY_RUNTIME_ROOT/build_receipt.json}"
