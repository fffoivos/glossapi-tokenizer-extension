{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glossapi.example/schemas/full_cpt_lineage_document_action_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stable_uid",
    "source_id",
    "source_dataset",
    "input_text_sha256",
    "action",
    "reason",
    "relationship_key",
    "resolution_policy"
  ],
  "properties": {
    "schema_version": {"const": "full_cpt_lineage_document_action_v1"},
    "stable_uid": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_id": {"type": "string", "minLength": 1},
    "source_dataset": {"type": "string", "minLength": 1},
    "input_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {"enum": ["drop", "quarantine"]},
    "reason": {"type": "string", "minLength": 1},
    "relationship_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolution_policy": {"type": "string", "minLength": 1}
  }
}
