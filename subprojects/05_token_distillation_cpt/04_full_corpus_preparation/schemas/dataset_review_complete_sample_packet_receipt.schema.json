{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glossapi.example/schemas/dataset-review-complete-sample-packet-receipt-v1.json",
  "title": "Receipt for local-only complete review samples",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "normalization_manifest", "canonical_root",
    "review_requests", "export_contract", "input_shards", "checkpoint_inventory",
    "checkpoint_inventory_sha256", "output", "redaction_totals",
    "high_precision_identifier_patterns_masked"
  ],
  "properties": {
    "schema_version": {"const": "dataset_review_complete_sample_packet_receipt_v1"},
    "status": {"const": "passed"},
    "normalization_manifest": {"$ref": "#/$defs/file"},
    "canonical_root": {"type": "string", "minLength": 1},
    "review_requests": {"$ref": "#/$defs/file"},
    "export_contract": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {"type": "object", "required": ["contract_sha256"], "properties": {"contract_sha256": {"$ref": "#/$defs/sha256"}}}
      ]
    },
    "input_shards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shard"}},
    "checkpoint_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_shard_sha256", "checkpoint_receipt_sha256", "output_sha256", "selected_rows"],
        "properties": {
          "input_shard_sha256": {"$ref": "#/$defs/sha256"},
          "checkpoint_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "output_sha256": {"$ref": "#/$defs/sha256"},
          "selected_rows": {"type": "integer", "minimum": 0}
        }
      }
    },
    "checkpoint_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "output": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {"type": "object", "required": ["rows"], "properties": {"rows": {"type": "integer", "minimum": 1}}}
      ]
    },
    "redaction_totals": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "high_precision_identifier_patterns_masked": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shard": {
      "type": "object",
      "required": ["source_id", "path", "bytes", "sha256", "rows"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
