{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glossapi.example/schemas/dataset-quality-document-v2.json",
  "title": "Per-document canonical and GlossAPI Rust quality metrics (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_id", "source_dataset", "source_repo_id", "source_revision",
    "source_route", "review_route", "extraction_route", "observed_extraction_route",
    "observed_extraction_route_basis", "observed_extraction_route_evidence",
    "observed_extraction_route_priority",
    "document_id", "normalized_text_sha256", "profile_text_sha256",
    "profile_text_variant", "input_shard_path",
    "input_shard_sha256", "input_row_index", "original_characters", "original_bytes_utf8",
    "original_non_whitespace_characters", "raw_greek_letters", "raw_latin_letters",
    "raw_greek_letter_fraction", "raw_html_tags", "raw_html_tags_per_1000_chars",
    "raw_html_entity_count", "raw_html_entity_per_1000_chars",
    "raw_script_style_tag_count", "raw_navigation_markup_tag_count",
    "raw_mojibake_markers", "raw_replacement_characters", "raw_mojibake_per_1000_chars",
    "raw_replacement_per_1000_chars",
    "raw_control_characters", "raw_control_per_1000_chars", "raw_nonempty_lines",
    "raw_unique_line_fraction", "raw_repeated_line_fraction", "raw_one_token_line_fraction",
    "raw_line_break_hyphenation_fraction", "raw_repeated_short_line_fraction",
    "raw_markdown_table_lines", "bibliography_header_detected", "toc_header_detected",
    "digital_governance_footer_detected", "personnel_cue_detected",
    "isolated_ada_stamp_lines", "private_data_true", "corrected_version_present",
    "structural_template_id", "direct_identifier_match_count", "direct_identifier_types",
    "structured_contract_declared", "structured_required_field_count",
    "structured_present_required_field_count", "structured_missing_required_field_count",
    "structured_metadata_max_depth",
    "rust_noise_badness_score", "rust_noise_latin_percentage", "rust_noise_table_ratio",
    "rust_noise_polytonic_ratio", "rust_noise_greek_characters", "rust_noise_total_words",
    "rust_noise_vowel_penalty", "rust_noise_consonant_penalty", "rust_noise_bad_double_count",
    "rust_noise_misplaced_final_sigma_count", "rust_noise_invalid_bigram_count",
    "rust_noise_long_word_count", "rust_noise_longest_word", "rust_noise_short_word_count",
    "rust_noise_max_character_run", "rust_noise_vowel_penalty_rate",
    "rust_noise_consonant_penalty_rate", "rust_noise_bad_double_rate",
    "rust_noise_final_sigma_rate", "rust_noise_invalid_bigram_rate", "rust_noise_long_word_rate",
    "rust_noise_short_word_ratio", "rust_noise_short_word_penalty", "rust_noise_flags",
    "cleaner_badness_score", "cleaner_greek_percentage", "cleaner_latin_percentage",
    "cleaner_characters_no_comments", "cleaner_is_empty", "cleaner_retained_character_ratio",
    "cleaner_removed_character_fraction", "zero_badness_zero_greek_guard",
    "noise_score_interpretation"
  ],
  "properties": {
    "schema_version": {"const": "dataset_quality_document_v2"},
    "source_id": {"$ref": "#/$defs/nonempty"},
    "source_dataset": {"$ref": "#/$defs/nonempty"},
    "source_repo_id": {"$ref": "#/$defs/nonempty"},
    "source_revision": {"$ref": "#/$defs/nonempty"},
    "source_route": {"$ref": "#/$defs/route"},
    "review_route": {"$ref": "#/$defs/route"},
    "extraction_route": {"$ref": "#/$defs/route"},
    "observed_extraction_route": {"$ref": "#/$defs/route"},
    "observed_extraction_route_basis": {"$ref": "#/$defs/observedRouteBasis"},
    "observed_extraction_route_evidence": {"$ref": "#/$defs/observedRouteEvidence"},
    "observed_extraction_route_priority": {"$ref": "#/$defs/observedRoutePriority"},
    "document_id": {"$ref": "#/$defs/sha256"},
    "normalized_text_sha256": {"$ref": "#/$defs/sha256"},
    "profile_text_sha256": {"$ref": "#/$defs/sha256"},
    "profile_text_variant": {"enum": ["canonical", "high_precision_identifier_masked_review_sample"]},
    "input_shard_path": {"$ref": "#/$defs/nonempty"},
    "input_shard_sha256": {"$ref": "#/$defs/sha256"},
    "input_row_index": {"$ref": "#/$defs/count"},
    "original_characters": {"$ref": "#/$defs/count"},
    "original_bytes_utf8": {"$ref": "#/$defs/count"},
    "original_non_whitespace_characters": {"$ref": "#/$defs/count"},
    "raw_greek_letters": {"$ref": "#/$defs/count"},
    "raw_latin_letters": {"$ref": "#/$defs/count"},
    "raw_greek_letter_fraction": {"$ref": "#/$defs/rate"},
    "raw_html_tags": {"$ref": "#/$defs/count"},
    "raw_html_tags_per_1000_chars": {"$ref": "#/$defs/number"},
    "raw_html_entity_count": {"$ref": "#/$defs/count"},
    "raw_html_entity_per_1000_chars": {"$ref": "#/$defs/number"},
    "raw_script_style_tag_count": {"$ref": "#/$defs/count"},
    "raw_navigation_markup_tag_count": {"$ref": "#/$defs/count"},
    "raw_mojibake_markers": {"$ref": "#/$defs/count"},
    "raw_replacement_characters": {"$ref": "#/$defs/count"},
    "raw_mojibake_per_1000_chars": {"$ref": "#/$defs/number"},
    "raw_replacement_per_1000_chars": {"$ref": "#/$defs/number"},
    "raw_control_characters": {"$ref": "#/$defs/count"},
    "raw_control_per_1000_chars": {"$ref": "#/$defs/number"},
    "raw_nonempty_lines": {"$ref": "#/$defs/count"},
    "raw_unique_line_fraction": {"$ref": "#/$defs/rate"},
    "raw_repeated_line_fraction": {"$ref": "#/$defs/rate"},
    "raw_one_token_line_fraction": {"$ref": "#/$defs/rate"},
    "raw_line_break_hyphenation_fraction": {"$ref": "#/$defs/rate"},
    "raw_repeated_short_line_fraction": {"$ref": "#/$defs/rate"},
    "raw_markdown_table_lines": {"$ref": "#/$defs/count"},
    "bibliography_header_detected": {"type": "boolean"},
    "toc_header_detected": {"type": "boolean"},
    "digital_governance_footer_detected": {"type": "boolean"},
    "personnel_cue_detected": {"type": "boolean"},
    "isolated_ada_stamp_lines": {"$ref": "#/$defs/count"},
    "private_data_true": {"type": "boolean"},
    "corrected_version_present": {"type": "boolean"},
    "structural_template_id": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "direct_identifier_match_count": {"$ref": "#/$defs/count"},
    "direct_identifier_types": {"type": "string"},
    "structured_contract_declared": {"type": "boolean"},
    "structured_required_field_count": {"$ref": "#/$defs/count"},
    "structured_present_required_field_count": {"$ref": "#/$defs/count"},
    "structured_missing_required_field_count": {"$ref": "#/$defs/count"},
    "structured_metadata_max_depth": {"$ref": "#/$defs/count"},
    "rust_noise_badness_score": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_latin_percentage": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_table_ratio": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_polytonic_ratio": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_greek_characters": {"$ref": "#/$defs/count"},
    "rust_noise_total_words": {"$ref": "#/$defs/count"},
    "rust_noise_vowel_penalty": {"$ref": "#/$defs/count"},
    "rust_noise_consonant_penalty": {"$ref": "#/$defs/count"},
    "rust_noise_bad_double_count": {"$ref": "#/$defs/count"},
    "rust_noise_misplaced_final_sigma_count": {"$ref": "#/$defs/count"},
    "rust_noise_invalid_bigram_count": {"$ref": "#/$defs/count"},
    "rust_noise_long_word_count": {"$ref": "#/$defs/count"},
    "rust_noise_longest_word": {"$ref": "#/$defs/count"},
    "rust_noise_short_word_count": {"$ref": "#/$defs/count"},
    "rust_noise_max_character_run": {"$ref": "#/$defs/count"},
    "rust_noise_vowel_penalty_rate": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_consonant_penalty_rate": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_bad_double_rate": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_final_sigma_rate": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_invalid_bigram_rate": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_long_word_rate": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_short_word_ratio": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_short_word_penalty": {"$ref": "#/$defs/nullableNumber"},
    "rust_noise_flags": {"type": "string"},
    "cleaner_badness_score": {"$ref": "#/$defs/nullableNumber"},
    "cleaner_greek_percentage": {"$ref": "#/$defs/nullableNumber"},
    "cleaner_latin_percentage": {"$ref": "#/$defs/nullableNumber"},
    "cleaner_characters_no_comments": {"$ref": "#/$defs/count"},
    "cleaner_is_empty": {"type": "boolean"},
    "cleaner_retained_character_ratio": {"$ref": "#/$defs/number"},
    "cleaner_removed_character_fraction": {"$ref": "#/$defs/rate"},
    "zero_badness_zero_greek_guard": {"type": "boolean"},
    "noise_score_interpretation": {"enum": ["guarded_zero_score_without_greek", "zero_score_with_greek", "scored"]}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "route": {"enum": ["html_web", "pdf_ocr", "mixed", "structured"]},
    "observedRouteBasis": {
      "enum": [
        "explicit_row_route", "row_representation_metadata",
        "declared_extraction_route_fallback", "unavailable",
        "legacy_canonical_without_observed_route"
      ]
    },
    "observedRouteEvidence": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001f]+$"
    },
    "observedRoutePriority": {
      "enum": ["logical_primary", "secondary_exception_only"]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "number": {"type": "number"},
    "nullableNumber": {"type": ["number", "null"]},
    "rate": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
