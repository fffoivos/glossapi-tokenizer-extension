{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structural_spans_manifest.schema.json",
  "title": "Final receipt-bound Phase-04 structural span inventory",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "raw_manifest_sha256",
    "model_receipt_sha256",
    "stage50_cleaning_manifest_sha256",
    "spans",
    "receipt_cycle_avoided"
  ],
  "properties": {
    "schema_version": {"const": "phase04_structural_spans_manifest_v1"},
    "status": {"const": "completed"},
    "raw_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "model_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "stage50_cleaning_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_cycle_avoided": {"const": true},
    "spans": {
      "type": "object",
      "required": ["path", "bytes", "sha256", "rows"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
