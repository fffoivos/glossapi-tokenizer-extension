{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glossapi.example/schemas/dataset-quality-summary-v1.json",
  "title": "Receipt-bound full-corpus dataset quality summary",
  "type": "object",
  "required": [
    "schema_version", "status", "created_at", "mode", "contract_sha256", "contract",
    "normalization_manifest", "glossapi_build_receipt", "glossapi_commit", "scan_mode", "batch_size",
    "threads", "quantile_sample_size", "selected_source_ids", "excluded_source_ids", "input_shards",
    "batch_checkpoints", "document_output",
    "global", "repositories", "metric_notes"
  ],
  "properties": {
    "schema_version": {"const": "dataset_quality_summary_v1"},
    "status": {"const": "passed"},
    "created_at": {"type": "string", "format": "date-time"},
    "mode": {"const": "diagnostic_only_no_cleaned_text_persisted"},
    "scan_mode": {"enum": ["review_sample", "full_scan"]},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "glossapi_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "batch_size": {"type": "integer", "minimum": 1},
    "threads": {"type": "integer", "minimum": 1},
    "quantile_sample_size": {"type": "integer", "minimum": 100},
    "selected_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "excluded_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_shards": {"type": "array", "minItems": 1},
    "batch_checkpoints": {
      "type": "object",
      "required": ["count", "rows", "inventory_sha256", "inventory"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "inventory": {"type": "array", "minItems": 1}
      }
    },
    "document_output": {"$ref": "#/$defs/file"},
    "global": {"$ref": "#/$defs/statistics"},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statistics"}},
    "metric_notes": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "statistics": {
      "type": "object",
      "required": ["documents", "characters", "bytes_utf8", "source_datasets", "document_counts", "document_rates", "distributions", "template_concentration"],
      "properties": {
        "repo_id": {"type": "string"},
        "documents": {"type": "integer", "minimum": 0},
        "characters": {"type": "integer", "minimum": 0},
        "bytes_utf8": {"type": "integer", "minimum": 0},
        "source_datasets": {"type": "array", "items": {"type": "string"}},
        "document_counts": {"type": "object"},
        "document_rates": {"type": "object"},
        "distributions": {"type": "object"},
        "template_concentration": {
          "type": "object",
          "required": ["documents_with_template", "unique_templates", "top_1_fraction", "top_10_fraction"],
          "properties": {
            "documents_with_template": {"type": "integer", "minimum": 0},
            "unique_templates": {"type": "integer", "minimum": 0},
            "top_1_fraction": {"type": "number", "minimum": 0, "maximum": 1},
            "top_10_fraction": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
