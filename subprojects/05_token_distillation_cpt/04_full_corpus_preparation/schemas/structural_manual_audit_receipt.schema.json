{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structural_manual_audit_receipt.schema.json",
  "title": "Manually completed structural false-deletion audit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "annotation_method",
    "automatic_adjudication_used",
    "reviewer_id",
    "packet_manifest_sha256",
    "annotations"
  ],
  "properties": {
    "schema_version": {"const": "academic_structural_manual_audit_receipt_v1"},
    "status": {"const": "completed"},
    "annotation_method": {"const": "manual"},
    "automatic_adjudication_used": {"const": false},
    "reviewer_id": {"type": "string", "minLength": 1},
    "packet_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "rows"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rows": {"const": 100}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

