{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glossapi.example/schemas/glossapi-rust-quality-build-receipt-v1.json",
  "title": "Pinned GlossAPI Rust quality runtime receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "created_at", "source", "runtime", "modules"],
  "properties": {
    "schema_version": {"const": "glossapi_rust_quality_build_receipt_v1"},
    "status": {"const": "passed"},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "commit", "cargo_locks"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/sha1"},
        "cargo_locks": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/file"}}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["python", "python_executable", "platform", "machine", "rustc", "cargo", "maturin"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "python_executable": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "rustc": {"type": "string", "minLength": 1},
        "cargo": {"type": "string", "minLength": 1},
        "maturin": {"type": "string", "minLength": 1}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/file"},
          {"type": "object", "required": ["name"], "properties": {"name": {"enum": ["glossapi_rs_noise", "glossapi_rs_cleaner"]}}}
        ]
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
