{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glossapi.example/schemas/agent1-v4-raw-review-request-v1.json",
  "title": "Agent 1 v4 raw review request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "sample_id",
    "source_id",
    "source_dataset",
    "source_doc_id",
    "source_revision",
    "source_route",
    "extraction_route",
    "document_path",
    "document_sha256",
    "document_bytes",
    "document_line_count",
    "origin_locator",
    "model",
    "prompt_sha256",
    "response_schema_sha256",
    "code_commit"
  ],
  "properties": {
    "schema_version": {"const": "agent1_v4_raw_review_request_v1"},
    "request_id": {"$ref": "#/$defs/sha256"},
    "sample_id": {"$ref": "#/$defs/sha256"},
    "source_id": {"type": "string", "minLength": 1},
    "source_dataset": {"type": "string", "minLength": 1},
    "source_doc_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "source_route": {"enum": ["html_web", "pdf_ocr", "mixed", "structured"]},
    "extraction_route": {"enum": ["html_web", "pdf_ocr", "mixed", "structured"]},
    "document_path": {"type": "string", "pattern": "^documents/[A-Za-z0-9_.-]+/[a-f0-9]{64}\\.txt$"},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "document_bytes": {"type": "integer", "minimum": 1},
    "document_line_count": {"type": "integer", "minimum": 1},
    "origin_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "artifact_path", "row_index", "representation_suffix", "text_field"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "row_index": {"type": "integer", "minimum": 0},
        "representation_suffix": {"type": "string", "minLength": 1},
        "text_field": {"type": "string", "minLength": 1}
      }
    },
    "model": {"const": "gpt-5.6-terra"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "response_schema_sha256": {"$ref": "#/$defs/sha256"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
