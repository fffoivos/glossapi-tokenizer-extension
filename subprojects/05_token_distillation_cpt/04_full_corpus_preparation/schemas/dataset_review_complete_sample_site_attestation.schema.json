{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glossapi.example/schemas/dataset-review-complete-sample-site-attestation-v1.json",
  "title": "Compact text-free complete-sample site attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "created_at", "packet", "review_requests",
    "primary_sample_count", "primary_sample_id_inventory_sha256", "normalization",
    "export_contract", "checkpoint_closure", "masking"
  ],
  "properties": {
    "schema_version": {"const": "dataset_review_complete_sample_site_attestation_v1"},
    "status": {"const": "passed"},
    "created_at": {"type": "string", "format": "date-time"},
    "packet": {"$ref": "#/$defs/fileWithRows"},
    "review_requests": {"$ref": "#/$defs/file"},
    "primary_sample_count": {"type": "integer", "minimum": 1},
    "primary_sample_id_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "normalization": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "manifest", "sources_config_sha256",
        "acquisition_receipt_sha256", "source_identities",
        "source_identity_inventory_sha256", "normalized_shard_inventory_sha256",
        "input_shards", "input_shard_inventory_sha256"
      ],
      "properties": {
        "schema_version": {"const": "full_cpt_normalization_manifest_v1"},
        "manifest": {"$ref": "#/$defs/file"},
        "sources_config_sha256": {"$ref": "#/$defs/sha256"},
        "acquisition_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "source_identities": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/sourceIdentity"}
        },
        "source_identity_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_shard_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "input_shards": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/shard"}
        },
        "input_shard_inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "export_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt", "canonical_sha256", "value"],
      "properties": {
        "receipt": {"$ref": "#/$defs/file"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "value": {"$ref": "#/$defs/exportContract"}
      }
    },
    "checkpoint_closure": {
      "type": "object", "additionalProperties": false,
      "required": [
        "count", "selected_rows", "inventory_sha256", "receipt_closure_sha256",
        "checkpoint_text_outputs_rehashed_for_attestation"
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "selected_rows": {"type": "integer", "minimum": 1},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_closure_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_text_outputs_rehashed_for_attestation": {"const": true}
      }
    },
    "masking": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pipeline", "implementation_sha256", "high_precision_identifier_patterns_masked",
        "private_data_true_rows", "redaction_totals", "redaction_totals_sha256"
      ],
      "properties": {
        "pipeline": {"const": "high_precision_identifier_patterns_v1"},
        "implementation_sha256": {
          "type": "object", "additionalProperties": false,
          "required": ["exporter", "build_source_review_packet", "greek_pii", "profile_dataset_quality_rust"],
          "properties": {
            "exporter": {"$ref": "#/$defs/sha256"},
            "build_source_review_packet": {"$ref": "#/$defs/sha256"},
            "greek_pii": {"$ref": "#/$defs/sha256"},
            "profile_dataset_quality_rust": {"$ref": "#/$defs/sha256"}
          }
        },
        "high_precision_identifier_patterns_masked": {"const": true},
        "private_data_true_rows": {"const": 0},
        "redaction_totals": {
          "type": "object",
          "propertyNames": {"enum": ["email", "ipv4", "iban", "afm", "amka", "phone", "url", "ipv6", "identity"]},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "redaction_totals_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileWithRows": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "rows"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "shard": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "path", "bytes", "sha256", "rows"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "sourceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_id", "repo_id", "revision", "role", "documents", "shards",
        "shard_inventory_sha256", "acquisition_selected_file_count",
        "acquisition_selected_bytes", "acquisition_file_inventory_sha256",
        "acquisition_kind", "mdc_dataset_id", "source_config_sha256"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "repo_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "acquisition_kind": {"type": "string", "minLength": 1},
        "mdc_dataset_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "source_config_sha256": {"$ref": "#/$defs/sha256"},
        "documents": {"type": "integer", "minimum": 1},
        "shards": {"type": "integer", "minimum": 1},
        "shard_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "acquisition_selected_file_count": {"type": "integer", "minimum": 1},
        "acquisition_selected_bytes": {"type": "integer", "minimum": 0},
        "acquisition_file_inventory_sha256": {"$ref": "#/$defs/sha256"}
      },
      "if": {
        "properties": {"acquisition_kind": {"const": "mozilla_data_collective"}},
        "required": ["acquisition_kind"]
      },
      "then": {"properties": {"mdc_dataset_id": {"type": "string", "minLength": 1}}},
      "else": {"properties": {"mdc_dataset_id": {"type": "null"}}}
    },
    "exportContract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "normalization_manifest_sha256", "review_requests_sha256",
        "exporter_script_sha256", "redaction_dependency_sha256", "redaction_pipeline",
        "batch_size", "selected_sample_count"
      ],
      "properties": {
        "schema_version": {"const": "dataset_review_sample_export_contract_v1"},
        "normalization_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "review_requests_sha256": {"$ref": "#/$defs/sha256"},
        "exporter_script_sha256": {"$ref": "#/$defs/sha256"},
        "redaction_dependency_sha256": {
          "type": "object", "additionalProperties": false,
          "required": ["build_source_review_packet", "greek_pii", "profile_dataset_quality_rust"],
          "properties": {
            "build_source_review_packet": {"$ref": "#/$defs/sha256"},
            "greek_pii": {"$ref": "#/$defs/sha256"},
            "profile_dataset_quality_rust": {"$ref": "#/$defs/sha256"}
          }
        },
        "redaction_pipeline": {"const": "high_precision_identifier_patterns_v1"},
        "batch_size": {"type": "integer", "minimum": 1},
        "selected_sample_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
