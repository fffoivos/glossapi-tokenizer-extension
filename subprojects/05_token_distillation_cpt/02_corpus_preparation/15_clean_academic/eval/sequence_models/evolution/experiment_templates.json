      "input_receipts": "${G5_INPUT_RECEIPTS}",
      "runner": {"module": "sequence_models.bibliography_evolution_composition", "argv": ["--table-dir", "${VALIDATION_TABLE_DIR}", "--left-prediction", "${LEFT_PREDICTION}", "--right-prediction", "${RIGHT_PREDICTION}", "--qualified-documents", "${QUALIFIED_268_IDS}", "--left-barrier-artifact", "${LEFT_BARRIER_ARTIFACT}", "--right-barrier-artifact", "${RIGHT_BARRIER_ARTIFACT}", "--operation", "${operation}", "--output-dir", "@CANDIDATE_DIR@/backend", "--code-commit", "${CODE_COMMIT}", "--slurm-job-id", "@SLURM_JOB_ID@"]}
    }
  ]
}
