{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bibliography-evolution-candidate-v1",
  "type": "object",
  "required": [
    "schema_version", "candidate_id", "generation", "parent_candidate_ids",
    "hypothesis", "changed_component", "parameter_family", "changes",
    "fixed_modules", "sweep_grid", "sweep_point", "seeds",
    "expected_direction", "acceptance_rule", "code_commit", "input_receipts",
    "runner"
  ],
  "properties": {
    "schema_version": {"const": "bibliography-evolution-candidate-v1"},
    "candidate_id": {"pattern": "^g[0-5]-[0-9a-f]{24}$"},
    "generation": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5"]},
    "parent_candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "hypothesis": {"type": "string", "minLength": 1},
    "changed_component": {"type": "string", "minLength": 1},
    "parameter_family": {"pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "changes": {"type": "object", "minProperties": 1, "maxProperties": 1},
    "fixed_modules": {"type": "array", "items": {"type": "string"}},
    "sweep_grid": {"type": "object"},
    "sweep_point": {"type": "object"},
    "seeds": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
    "expected_direction": {"type": "object", "minProperties": 1},
    "acceptance_rule": {"type": "object", "minProperties": 1},
    "code_commit": {"pattern": "^[0-9a-f]{40}$"},
    "input_receipts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256", "data_class", "split", "document_scope"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "digest_kind": {"enum": ["file_sha256", "recursive_tree_sha256_v1"]},
          "data_class": {"type": "string", "minLength": 1},
          "split": {"type": "string", "minLength": 1},
          "document_scope": {"type": "string", "minLength": 1},
          "contains_labels": {"type": "boolean"},
          "candidate_id": {"type": "string"},
          "parent_candidate_id": {"type": "string"}
        }
      }
    },
    "runner": {
      "type": "object",
      "required": ["module", "argv"],
      "properties": {
        "module": {
          "enum": [
            "sequence_models.bibliography_evolution_g0_replay",
            "sequence_models.bibliography_evolution_core_decode",
            "sequence_models.bibliography_evolution_postprocess",
            "sequence_models.bibliography_evolution_signal_pipeline",
            "sequence_models.bibliography_evolution_composition"
          ]
        },
        "argv": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
