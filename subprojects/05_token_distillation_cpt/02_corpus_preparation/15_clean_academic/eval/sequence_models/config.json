      "char_ngram_min": 2,
      "char_ngram_max": 5,
      "epochs": 18,
      "learning_rate": 0.05,
      "l2": 0.0001,
      "gradient_clip": 5.0
    },
    {
      "id": "n1-bytecnn-tcn-masked-crf",
      "kind": "char_tcn_crf",
      "status": "scaffold_ready_cpu_shadow_only",
      "silver_targets": ["bib", "joint_when_task_scope_includes_toc"],
      "max_utf8_bytes_per_line": 256,
      "byte_embedding_dim": 32,
      "char_channels_per_kernel": 48,
      "char_kernels": [3, 5, 7],
      "hidden_dim": 128,
      "tcn_dilations": [1, 2, 4, 8],
      "dropout": 0.15
    },
    {
      "id": "n2-charcnn-bilstm-crf",
      "kind": "research_only",
      "status": "deferred_until_n1_plateaus"
    },
    {
      "id": "n3-filtered-semi-markov-crf",
      "kind": "research_only",
      "status": "deferred_until_boundary_fragmentation_is_measured"
    }
  ],
  "calibration": {
