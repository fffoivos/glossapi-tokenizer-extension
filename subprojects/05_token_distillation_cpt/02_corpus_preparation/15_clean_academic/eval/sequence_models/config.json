      "learning_rate": 0.08,
      "l2": 0.0001,
      "gradient_clip": 5.0
    },
    {
      "id": "c2-char-ngram-feature-bioes-crf",
      "kind": "feature_crf",
      "silver_targets": ["bib", "joint_when_task_scope_includes_toc"],
