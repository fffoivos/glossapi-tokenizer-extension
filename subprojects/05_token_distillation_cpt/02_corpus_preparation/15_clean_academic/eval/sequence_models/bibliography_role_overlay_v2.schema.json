{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bibliography role overlay v2 row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_id", "work_id", "line_id", "abs_idx",
    "text_sha256", "original_region_label", "role", "role_status",
    "boundary_flag", "boundary_status", "role_confidence",
    "boundary_confidence", "label_origin", "reviewers", "review_case_ids",
    "raw_role_votes", "raw_boundary_votes"
  ],
  "properties": {
    "schema_version": {"const": "bibliography-role-overlay-v2", "type": "string"},
    "document_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "line_id": {"type": "string", "minLength": 1},
    "abs_idx": {"type": "integer", "minimum": 0},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "original_region_label": {"type": "string"},
    "role": {"enum": ["ENTRY_ANCHOR", "CONTINUATION", "FILLER", "HEADER", "SUBHEADER", "NON_BIB", "UNKNOWN"]},
    "role_status": {"enum": ["ADJUDICATED", "AGREED_REVIEW", "PROVISIONAL", "SINGLE_REVIEW", "UNRESOLVED"]},
    "boundary_flag": {"enum": ["NONE", "SOFT_STOP", "HARD_STOP"]},
    "boundary_status": {"enum": ["ADJUDICATED", "AGREED_REVIEW", "PROVISIONAL", "SINGLE_REVIEW", "UNRESOLVED"]},
    "role_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "boundary_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "label_origin": {"type": "string", "minLength": 1},
    "reviewers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_case_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "raw_role_votes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "raw_boundary_votes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
  }
}
