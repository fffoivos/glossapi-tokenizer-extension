{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer", "cases"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "bibliography-header-context-adjudication-v1"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "label", "confidence", "reason"],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "label": {
            "type": "string",
            "enum": [
              "ENTRY",
              "BIB_HEADER",
              "BIB_SUBHEADER",
              "OTHER_STRUCTURE",
              "UNCERTAIN"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}
