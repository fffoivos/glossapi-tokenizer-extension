# ============================================================================
# ARM 2 — MODERN GREEK: extended tokenizer (148,480 = 131,072 + 17,408 modern
# Greek). The 17,408 new rows are initialized by Token Distillation (layer 11):
# E (input) by MSE-on-hiddens distillation, U (output/lm_head) by cross-entropy
# (learn_output_with_ce=True). See RUNBOOK.md.
# Sourced as TRAIN_CONFIG_OVERRIDE; bakeoff_train.sbatch routes ARM=td ->
# EXT_TOKENIZER_DIR + EXT_DATA_PREFIX (the `td` arm branch).
# ============================================================================
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common_cpt.env"

ARM_NAME="modern_greek_td"  # pass ARM=td via --export at submit time

# Megatron init checkpoint: the TD layer-11 E+U init, geometry-reverted,
# R17-patched, TP=2/PP=1. See RUNBOOK.md.
# REUSE the existing td_full25_layer11_r17_roundtrip ckpt ONLY if its tokenizer
# is byte-identical to EXT_TOKENIZER_DIR (apertus_greek_modern_only_148480).
INIT_CKPT="${INIT_CKPT:-/iopsstor/scratch/cscs/fffoivos/init_checkpoints/cpt_2arm_13b/modern_greek_td148480/megatron_tp2_r17patched}"

# Data: EXT-148480 tokenization of the SAME shared 13.5B Stage-C stream.
# Stage C physically preserves replay/non-new-Greek slots and orders new-Greek
# slots HPLT then openarchives, but Megatron randomizes train sample
# consumption; this is not an executed curriculum guarantee. Byte-identical
# document stream as arm1 (only the tokenization differs).
EXT_DATA_PREFIX="${EXT_DATA_PREFIX:-/iopsstor/scratch/cscs/fffoivos/cpt_corpus/cpt_2arm_13b/megatron/bulk_mix_ordered_replay_fixed_ext_text_document}"
