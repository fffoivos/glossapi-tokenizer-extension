# ============================================================================
# ARM 1 — VANILLA (control): Apertus base tokenizer (131,072), no embedding
# extension, no Token Distillation. Pure CPT on the Greek mix.
# Sourced as TRAIN_CONFIG_OVERRIDE; bakeoff_train.sbatch routes ARM=vanilla ->
# BASE_TOKENIZER_DIR + BASE_DATA_PREFIX.
# ============================================================================
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common_cpt.env"

ARM_NAME="vanilla"          # pass ARM=vanilla via --export at submit time

# Megatron init checkpoint: Apertus-8B-2509 `main`, geometry-reverted to
# rope500k / seq4096 / llama3x8, R17-patched, TP=2/PP=1. See RUNBOOK.md.
INIT_CKPT="${INIT_CKPT:-/iopsstor/scratch/cscs/fffoivos/init_checkpoints/cpt_2arm_13b/vanilla_base131072/megatron_tp2_r17patched}"

# Data: BASE-131072 tokenization of the shared 13.5B bulk mix after Stage C.
# Stage C physically preserves replay/non-new-Greek slots and orders new-Greek
# slots HPLT then openarchives, but Megatron randomizes train sample
# consumption; this is not an executed curriculum guarantee.
BASE_DATA_PREFIX="${BASE_DATA_PREFIX:-/iopsstor/scratch/cscs/fffoivos/cpt_corpus/cpt_2arm_13b/megatron/bulk_mix_ordered_replay_fixed_base_text_document}"
