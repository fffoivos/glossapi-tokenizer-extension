# ============================================================================
# Common CPT config — two-arm 13.5B full-run Greek CPT of Apertus-8B.
# Sourced by the ESTABLISHED trainer
#   03_.../init_bakeoff/bakeoff_training/bakeoff_train.sbatch
# (thin wrapper over swiss-ai/Megatron-LM fork pretrain_gpt.py, byte-mirroring
#  Apertus's submit_apertus_8b.sh). Arm configs source THIS file then add the
#  per-arm tokenizer / init-checkpoint / data-prefix.
#
# Hyperparameter policy reference: subprojects/CURRENT_HYPERPARAMETERS.md v1.0.
# Values that DEVIATE from Apertus pretraining are marked [CHG]; everything
# else is Apertus-faithful. β2/α/peak-LR are STARTING values for the peak-LR
# sweep — keep them overridable.
# ============================================================================

# ---- established code (Clariden scratch) ----
APERTUS_BASE_HF="/iopsstor/scratch/cscs/fffoivos/models/apertus-8b-2509"
MEGATRON_LM_SWISSAI_DIR="/iopsstor/scratch/cscs/fffoivos/code/training/Megatron-LM-Swiss-AI"
MEGATRON_LM_SWISSAI_COMMIT="c92402e39ef3c8e69ea378a59e79059dc14541f4"

# ---- optimizer: AdEMAMix (Swiss-AI Megatron fork) ----
ADEMA_BETA1="0.9"
ADEMA_BETA2="${ADEMA_BETA2:-0.995}"   # [CHG] Apertus 0.999 — faster 2nd-moment for shift; sweep [0.99,0.999]
ADEMA_BETA3="${ADEMA_BETA3:-0.999}"   # [CHG] Apertus 0.9999 — low-iteration regime (AdEMAMix App C.1.5)
ADEMA_ALPHA="${ADEMA_ALPHA:-4.0}"     # [CHG] Apertus 8 — lower β3 + large batch
ADEMA_WEIGHT_DECAY="0.1"
ADEMA_BETA_START="$ADEMA_BETA1"
GRAD_CLIP="0.1"
INIT_STD="0.008944"

# ---- LR schedule: WSD trapezoid, peak = 0.5x Apertus ----
LR_PEAK="${LR_PEAK:-5.5e-5}"          # [CHG] 0.5 x Apertus 1.1e-4 — sweep target
LR_FINAL="${LR_FINAL:-5.5e-6}"        # 0.1 x peak (Apertus cooldown floor ratio)
LR_SCHEDULE_STYLE="WSD"
LR_DECAY_STYLE="1-sqrt"               # Apertus cooldown shape
LR_WARMUP_INIT="${LR_WARMUP_INIT:-5.5e-6}"   # 0.1 x peak (Apertus warmup start)

# ---- geometry: Apertus MAIN-pretraining (paper §2.4 + Table C.4; ----
#      submit_apertus_8b.sh L188-192). We start from `main` (which carries the
#      post-long-context geometry rope 12M / seq 65536) and REVERT to this.
SEQ_LENGTH="4096"
MAX_POSITION_EMBEDDINGS="4096"
ROTARY_BASE="500000"
USE_ROPE_SCALING="1"                  # ON in Apertus main pretraining (submit_apertus_8b.sh:191) — the Vanilla-5B run OMITTED this
ROPE_SCALING_FACTOR="8.0"             # NTK / llama3, factor 8 (Table C.4)
MAKE_VOCAB_SIZE_DIVISIBLE_BY="256"   # tokenizer is 256-aligned (148480 = 256×580); pad multiple = 256×TP(2)=512, both vocabs already divisible      # Apertus/Megatron padding flag; ext vocab itself is 148480 = 256 * 580

# ---- batch / precision / parallelism ----
MICROBATCH_SIZE="2"
GLOBAL_BATCH_SIZE="1024"
GLOBAL_BATCH_TOKENS="4194304"
MIXED_PRECISION_FLAG="--bf16"
MAIN_GRADS_DTYPE="fp32"
TENSOR_MODEL_PARALLEL_SIZE="${TENSOR_MODEL_PARALLEL_SIZE:-2}"
PIPELINE_MODEL_PARALLEL_SIZE="${PIPELINE_MODEL_PARALLEL_SIZE:-1}"

# ---- architecture extras (Apertus-faithful) ----
ACTIVATION_FLAG="--xielu"
XIELU_INIT_AP="0.8"
XIELU_INIT_AN="0.8"
QK_LAYERNORM_FLAG="--qk-layernorm"
QKNORM_IMPL="apex"
NORMALIZATION="RMSNorm"

# ---- loss: Goldfish, exactly as Apertus-8B (k=h=50, 2% mask) ----
LOSS_OBJECTIVE="${LOSS_OBJECTIVE:-goldfish}"
GOLDFISH_K="50"
GOLDFISH_H="50"

# ---- attention masking (cross-document) ----
CROSS_DOC_ATTN_FLAGS="--reset-attention-mask --reset-position-ids"
EOD_LOSS_MASK_FLAG="--eod-mask-loss"

# ---- tokenizers (fixed artifacts; per-arm selection by bakeoff_train.sbatch case "$ARM") ----
BASE_TOKENIZER_DIR="${BASE_TOKENIZER_DIR:-/iopsstor/scratch/cscs/fffoivos/models/apertus-8b-2509}"               # 131,072 (arm1)
EXT_TOKENIZER_DIR="${EXT_TOKENIZER_DIR:-/iopsstor/scratch/cscs/fffoivos/tokenizers/apertus_greek_modern_only_148480}"  # 148,480 (arm2)

# ---- full-run budget: 10B NEW Greek + replay (24/4/2/5 % OF the new-Greek) = 13.5B ----
TRAIN_TOKENS="${TRAIN_TOKENS:-13500000000}"

# ---- derived schedule (recomputed if TRAIN_TOKENS / batch change) ----
SEQ_LEN="$SEQ_LENGTH"
TRAIN_SAMPLES="$(( TRAIN_TOKENS / SEQ_LENGTH ))"                 # 3,295,898
TRAIN_ITERS="$(( TRAIN_SAMPLES / GLOBAL_BATCH_SIZE ))"          # ~3,218
# Warmup = 2/(1-β2) iterations (POLICY — Ma & Yarats untuned-warmup horizon;
#   user decision 2026-06-09). Computed from β2 so it scales across the sweep:
#   β2 0.99->200, 0.995->400, 0.999->2000 iters. (1% of the run would be ~32 iters.)
LR_WARMUP_ITERS="${LR_WARMUP_ITERS:-$(awk -v b="$ADEMA_BETA2" 'BEGIN{printf "%d", (2/(1-b))+0.5}')}"
LR_WARMUP_TOKENS="${LR_WARMUP_TOKENS:-$(( LR_WARMUP_ITERS * GLOBAL_BATCH_TOKENS ))}"   # 1.678B
# Cooldown = final 20% of the run, 1-sqrt (consumes our new bakeoff_train knob).
LR_WSD_DECAY_SAMPLES="${LR_WSD_DECAY_SAMPLES:-$(( TRAIN_SAMPLES / 5 ))}"               # 659,179 (~644 iters)
# α/β3 warmup over the WHOLE run (T_{α,β3}=T), warmed from β_start=β1.
ADEMA_BETA3_WARMUP_STEPS="${ADEMA_BETA3_WARMUP_STEPS:-$TRAIN_ITERS}"
ADEMA_ALPHA_WARMUP_STEPS="${ADEMA_ALPHA_WARMUP_STEPS:-$TRAIN_ITERS}"

# ---- data (shared bulk mix; SAME seed across arms => byte-identical doc stream) ----
DATA_SEED="${DATA_SEED:-20260609}"
DATALOADER_WORKERS="${DATALOADER_WORKERS:-4}"

# ---- checkpoint cadence: ~0.5B tokens = 119 iters ----
SAVE_INTERVAL="${SAVE_INTERVAL:-119}"
# In-loop eval drives the 3 per-set held-out validation losses (EXTRA_VALID
# patch). The 16-node production smoke measured about 11s per three-set eval
# event; the older 145s figure was from a 1-node annotation. EVAL_INTERVAL=25
# gives dense held-out curves while keeping eval overhead modest. Benchmarks
# remain sidecar.
EVAL_INTERVAL="${EVAL_INTERVAL:-25}"
EVAL_ITERS="${EVAL_ITERS:-1}"
EXIT_INTERVAL="${EXIT_INTERVAL:-}"         # set per segment by the submitter
RESUME_TRAINING="${RESUME_TRAINING:-0}"
DISABLE_SAVE="${DISABLE_SAVE:-0}"

# ---- slurm (Clariden; xfer is in maintenance till 2026-06-11 — use normal) ----
PARTITION="${PARTITION:-normal}"
TIME_LIMIT="${TIME_LIMIT:-12:00:00}"
# Full 13.5B two-arm CPT is a launch-scale run, not a 1-node diagnostic.
# With TP=2 and global batch 1024, 16 nodes/arm keeps the checkpoint geometry
# unchanged and scales only data parallelism: world=64, DP=32, 16 microbatches.
NODES="${NODES:-16}"
GPUS_PER_NODE="${GPUS_PER_NODE:-4}"
LAUNCH_MODE="${LAUNCH_MODE:-}"
if [ -z "$LAUNCH_MODE" ]; then
    if [ "$NODES" -gt 1 ]; then
        # Established bakeoff behavior: direct multi-task Slurm launch has hit
        # inter-node NCCL/OFI failures before iteration 1 on Clariden. Use one
        # Slurm task per node and let torchrun fan out to the local GPUs.
        LAUNCH_MODE="torchrun"
    else
        LAUNCH_MODE="slurm"
    fi
fi
ACCOUNT="${ACCOUNT:-a0140}"
UENV_IMAGE="${UENV_IMAGE:-pytorch/v2.9.1:v2}"
