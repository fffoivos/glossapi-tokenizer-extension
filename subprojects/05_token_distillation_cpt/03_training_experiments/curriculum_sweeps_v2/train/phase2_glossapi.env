# Phase-2 arm config (TRAIN_CONFIG_OVERRIDE). Identical to phase1 EXCEPT the new-Greek stream is now
# glossapi_only; the replay weight R is unchanged. LR/WSD/AdEMAMix/TRAIN_TOKENS are inherited UNCHANGED
# from curriculum_common.env -> the WSD trapezoid is the same one phase-1 started -> continuous across
# the boundary (the schedule is anchored to the full-run --train-samples, not the per-phase length).
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/curriculum_common.env"
ARM_NAME="curriculum_phase2_glossapi"
INIT_CKPT="${INIT_CKPT:-$INIT_TD}"

EXT_DATA_PREFIX="1.0 $MEGOUT/glossapi_only_ext_text_document $R $MEGOUT/replay_only_ext_text_document"
BASE_DATA_PREFIX="1.0 $MEGOUT/glossapi_only_base_text_document $R $MEGOUT/replay_only_base_text_document"

EXTRA_VALID_SETS="hplt openarchives greek_phd english de ru zh code old_greek"
