# Sourced by phase1_hplt.env and phase2_glossapi.env. Inherits ALL pilot hyperparameters from the
# deployed common_cpt.env (GBS 1024 x seq 4096, AdEMAMix 0.9/0.995/0.999 alpha4, Goldfish k=h=50,
# WSD 1-sqrt 20% cooldown, warmup 2/(1-beta2)=400, rope500k/seq4096, TP2/PP1, bf16, EVAL_INTERVAL=25,
# NCCL_NET_FORCE_FLUSH default 0) and sets only the v2-specific knobs. Single-sourcing LR/WSD/AdEMAMix
# here (not via --export) keeps submit_*'s export-hygiene guard intact.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)/paths.env"
source "$THIS/configs/common_cpt.env"

# v2 held-out (extra-valid) binaries live in the curriculum_v2 megatron dir
VAL_DATA_DIR="$MEGOUT"

# replay BLEND fraction (overridden per replay-sweep point); control = 0.35
R="${R:-0.35}"

# peak LR overridable for the LR sweep (d): {2.75e-5, 5.5e-5 control, 8.25e-5, 1.1e-4}.
# LR_WARMUP_ITERS stays 2/(1-beta2)=400 (beta2 fixed); only the peak moves.
LR_PEAK="${LR_PEAK:-5.5e-5}"

# Two-phase boundary as an ABSOLUTE iteration. Provisional default = 2261
# (nearest multiple of SAVE_INTERVAL=119 for the 8.5B/(8.5B+3.7B) phase ratio
# over TOTAL_ITER=3218). Recompute from realized hplt_only/glossapi_only .bin
# sizes after stageB before live sweeps.
PHASE1_EXIT_ITER="${PHASE1_EXIT_ITER:-2261}"

# Wrapper chain: reset_data_index_guard.py -> pretrain_gpt_te_guard.py -> pretrain_gpt.py.
# Only the first phase-2 segment exports RESET_DATA_INDEX=1 (submit_curriculum_two_phase.sh).
# bakeoff_train.sbatch invokes "$RUNTIME_PATCH_DIR/pretrain_gpt_te_guard.py"; we prepend our guard.
TRAINER_WRAPPER="$V2/train/runtime_patches/reset_data_index_guard.py"

# 9-set extra-valid list (3 new-Greek adaptation + 6 old-data forgetting). Requires UPSTREAM EDIT #1
# (bakeoff_train.sbatch reads the NAME list from EXTRA_VALID_SETS; default = the 3 pilot sets).
EXTRA_VALID_SETS="${EXTRA_VALID_SETS:-hplt openarchives greek_phd english de ru zh code old_greek}"
