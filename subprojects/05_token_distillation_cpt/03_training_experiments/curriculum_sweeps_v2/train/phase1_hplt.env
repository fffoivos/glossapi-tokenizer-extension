# Phase-1 arm config (TRAIN_CONFIG_OVERRIDE). New-Greek = HPLT, blended with replay at weight R.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/curriculum_common.env"
ARM_NAME="curriculum_phase1_hplt"
INIT_CKPT="${INIT_CKPT:-$INIT_TD}"   # submitter overrides to $INIT_VANILLA for the vanilla control

# WEIGHTED BLEND (Megatron --data-path "w1 p1 w2 p2 ...").
# bakeoff_train.sbatch:390 emits `--data-path $ARM_DATA_PREFIX` UNQUOTED, so this multi-token string
# word-splits into the weighted-blend form (arguments.py:2020-2027). Megatron normalizes the weights.
if [ -n "$FOREIGN_REPLAY_R" ] || [ -n "$OLD_GREEK_REPLAY_R" ]; then
  : "${FOREIGN_REPLAY_R:?set FOREIGN_REPLAY_R when using split replay}"
  : "${OLD_GREEK_REPLAY_R:?set OLD_GREEK_REPLAY_R when using split replay}"
  EXT_DATA_PREFIX="1.0 $MEGOUT/hplt_only_ext_text_document $FOREIGN_REPLAY_R $MEGOUT/foreign_replay_only_ext_text_document $OLD_GREEK_REPLAY_R $MEGOUT/old_greek_replay_only_ext_text_document"
  BASE_DATA_PREFIX="1.0 $MEGOUT/hplt_only_base_text_document $FOREIGN_REPLAY_R $MEGOUT/foreign_replay_only_base_text_document $OLD_GREEK_REPLAY_R $MEGOUT/old_greek_replay_only_base_text_document"
else
  EXT_DATA_PREFIX="1.0 $MEGOUT/hplt_only_ext_text_document $R $MEGOUT/replay_only_ext_text_document"
  BASE_DATA_PREFIX="1.0 $MEGOUT/hplt_only_base_text_document $R $MEGOUT/replay_only_base_text_document"
fi

# 9-set extra-valid (3 adaptation + 6 forgetting). Names map to val_<name>_<tok> (new-Greek) and
# val_forget_<name>_<tok> (forgetting); the per-arm base/ext suffix is applied by bakeoff_train.sbatch.
EXTRA_VALID_SETS="hplt openarchives greek_phd english de ru zh code old_greek"
