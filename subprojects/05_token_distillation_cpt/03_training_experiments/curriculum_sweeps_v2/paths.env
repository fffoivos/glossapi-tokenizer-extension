# curriculum_sweeps_v2 — single source of truth for paths/ids. Sourced by every sbatch/sh here.
# (verified against the deployed pilot infra, 2026-06-11)
SC=/iopsstor/scratch/cscs/fffoivos
REPO_ROOT=$SC/repo/glossapi-tokenizer-extension
SUB=$REPO_ROOT/subprojects/05_token_distillation_cpt
THIS=$SUB/03_training_experiments
V2=$THIS/curriculum_sweeps_v2
# established code (the LEGACY mirror holds corpus_build + the trainer — NOT under glossapi-tokenizer-extension)
LEGACY=$SC/repo/03_apertus_extension_and_embedding_adaptation/03_4_implementation_experiments/init_bakeoff
CB=$LEGACY/corpus_build
MIX_BUILDER=$CB/mix_builder.py
TRAIN_DIR=$REPO_ROOT/subprojects/03_apertus_extension_and_embedding_adaptation/03_4_implementation_experiments/init_bakeoff/bakeoff_training
TRAIN_SCRIPT=$TRAIN_DIR/bakeoff_train.sbatch
MEG=$SC/code/training/Megatron-LM-Swiss-AI   # @ c92402e39ef3c8e69ea378a59e79059dc14541f4
EVAL_DIR=$LEGACY/eval
DECONTAM=$SUB/02_corpus_preparation/30_decontaminate/scripts/decontaminate.py
ANON=$SUB/02_corpus_preparation/40_anonymize/scripts/anonymize.py
HPLT_CLEAN=$THIS/dataset_build/hplt_clean.py
# tokenizers (fixed)
BASE_TOK=$SC/models/apertus-8b-2509                       # 131072
EXT_TOK=$SC/tokenizers/apertus_greek_modern_only_148480   # 148480
EXT_HF_TOK=$SC/token_distillation/td_full25_layer11_r17_roundtrip_2357565/hf_roundtrip  # config.json+tokenizer.json for eval HF convert
# init checkpoints (Megatron tp2 r17patched)
INIT_VANILLA=$SC/init_checkpoints/cpt_2arm_13b/vanilla_base131072/megatron_tp2_r17patched
INIT_TD=$SC/init_checkpoints/cpt_2arm_13b/modern_greek_td148480/megatron_tp2_r17patched
# data pools
SELECTED=$SC/cpt_corpus/cpt/selected_after_apertus_and_internal_dedup.parquet
GREEK_REPLAY=$SC/cpt_corpus/greek_replay/greek_replay.parquet
QUERIES=/capstor/scratch/cscs/fffoivos/runs/05_token_distillation_cpt/decontamination/05_decontam_5b_20260602T011447Z/queries/native_greek_mcq_decontam_queries.jsonl
# v2 staging (NEW; do NOT clobber the pilot cpt_2arm_13b dir)
STAGE=$SC/cpt_corpus/curriculum_v2
MEGOUT=$STAGE/megatron
RUN_ROOT=/capstor/scratch/cscs/fffoivos/runs/curriculum_v2
# xfer is in maintenance -> CPU builds route to `normal` --cpus-per-task=64 --mem=400G
BUILD_PARTITION=normal
PY=$SC/python_envs/cpt_build_xfer_py312/bin/python   # x86 compute-node binary; only runs INSIDE srun (not the login node)
