# Two-phase 25B recipe adapter for bakeoff_train.sbatch.
# BRIDGE_DATA_ENV and CPT_PHASE are supplied by the receipt-gated launcher.
: "${BRIDGE_DATA_ENV:?set BRIDGE_DATA_ENV}"
: "${CPT_PHASE:?set CPT_PHASE to 1 or 2}"
: "${START_ITERATION:?set START_ITERATION}"
: "${END_ITERATION:?set END_ITERATION}"
source "$BRIDGE_DATA_ENV"

case "$CPT_PHASE" in
  1)
    FULL_CPT_DATA_PREFIX="$PHASE1_CPT_DATA_PREFIX"
    CPT_PHASE_START_ITERATION="0"
    ;;
  2)
    FULL_CPT_DATA_PREFIX="$PHASE2_CPT_DATA_PREFIX"
    CPT_PHASE_START_ITERATION="3570"
    ;;
  *)
    echo "ERROR: CPT_PHASE must be 1 or 2" >&2
    return 2
    ;;
esac

THIS_CONFIG_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$THIS_CONFIG_DIR/../../05_training_dataset_bridge/train/full_corpus_25b.env"

# Replace the superseded single-blend/physical-order semantics after the shared
# 25B hyperparameter file has established every other frozen setting.
ARM_NAME="greek_cpt_25b_midtraining_phase_${CPT_PHASE}"
FULL_CPT_DATA_PREFIX="$FULL_CPT_DATA_PREFIX"
BASE_DATA_PREFIX="$FULL_CPT_DATA_PREFIX"
EXT_DATA_PREFIX="$FULL_CPT_DATA_PREFIX"
CURRICULUM_ORDER_MODE="randomized"
unset MEGATRON_GPT_DATASET_NO_SHUFFLE
DATA_SEED="20260609"
TRAINER_WRAPPER="$THIS_CONFIG_DIR/runtime_patches/phase_relative_data_index.py"
CPT_GLOBAL_BATCH_SIZE="$GLOBAL_BATCH_SIZE"
NEW_GREEK_VALID_SETS="hplt non_hplt openarchives greek_phd historical_polytonic"
FULL_CPT_REQUIRE_JOB_START_VERIFY="0"
TIME_LIMIT="08:00:00"
EXIT_INTERVAL="$END_ITERATION"
RESUME_TRAINING="0"
if (( START_ITERATION > 0 )); then
  RESUME_TRAINING="1"
fi

export CPT_PHASE CPT_PHASE_START_ITERATION CPT_GLOBAL_BATCH_SIZE
export TRAINER_WRAPPER NEW_GREEK_VALID_SETS CURRICULUM_ORDER_MODE DATA_SEED
export EXIT_INTERVAL RESUME_TRAINING

# Receipt validation is performed by clariden/train_segment.sbatch immediately
# before this config is sourced. The old single-blend assertion is inapplicable.
unset FULL_CPT_FROZEN_RECIPE_CONTRACT FULL_CPT_FROZEN_UNSET_VARIABLES
unset -f full_cpt_assert_frozen_recipe 2>/dev/null || true
