# Isolated one-node validation of the frozen two-phase training semantics.
# This deliberately changes only the amount of work required to exercise a
# forward/backward step, checkpoint save/load, and the phase-relative data
# reset. Production segments never source this file.
: "${CPT_SMOKE:?set CPT_SMOKE=1}"
[[ "$CPT_SMOKE" == "1" ]] || { echo "ERROR: CPT_SMOKE must be exactly 1" >&2; return 2; }

THIS_SMOKE_CONFIG_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$THIS_SMOKE_CONFIG_DIR/phase_config.env"

case "$CPT_PHASE:$START_ITERATION:$END_ITERATION" in
  1:0:1) CPT_PHASE_START_ITERATION="0" ;;
  2:1:2) CPT_PHASE_START_ITERATION="1" ;;
  *) echo "ERROR: invalid smoke phase boundary" >&2; return 2 ;;
esac

# TP=2 and four GPUs imply DP=2. A global batch of 8 with microbatch 2 gives
# two microbatches per data-parallel rank: enough to exercise accumulation
# without spending production-scale compute on a smoke.
MICROBATCH_SIZE="2"
GLOBAL_BATCH_SIZE="8"
GLOBAL_BATCH_TOKENS="32768"
TRAIN_TOKENS="65536"
TRAIN_SAMPLES="16"
TRAIN_ITERS="2"
LR_WARMUP_ITERS="1"
LR_WARMUP_TOKENS="32768"
LR_WSD_DECAY_SAMPLES="4"
ADEMA_BETA3_WARMUP_STEPS="2"
ADEMA_ALPHA_WARMUP_STEPS="2"
SAVE_INTERVAL="1"
EVAL_INTERVAL="1"
EVAL_ITERS="1"
TIME_LIMIT="01:30:00"
NODES="1"
GPUS_PER_NODE="4"
EXIT_INTERVAL="$END_ITERATION"
RESUME_TRAINING="0"
if (( START_ITERATION > 0 )); then
  RESUME_TRAINING="1"
fi
CPT_GLOBAL_BATCH_SIZE="$GLOBAL_BATCH_SIZE"

export CPT_PHASE_START_ITERATION CPT_GLOBAL_BATCH_SIZE
export GLOBAL_BATCH_SIZE GLOBAL_BATCH_TOKENS TRAIN_TOKENS TRAIN_SAMPLES TRAIN_ITERS
export LR_WARMUP_ITERS LR_WARMUP_TOKENS LR_WSD_DECAY_SAMPLES
export ADEMA_BETA3_WARMUP_STEPS ADEMA_ALPHA_WARMUP_STEPS
export SAVE_INTERVAL EVAL_INTERVAL EVAL_ITERS TIME_LIMIT NODES GPUS_PER_NODE
export EXIT_INTERVAL RESUME_TRAINING
