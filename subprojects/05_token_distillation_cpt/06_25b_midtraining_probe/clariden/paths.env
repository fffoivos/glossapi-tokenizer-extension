# Receipt-bound Clariden paths for the 25B two-phase build.
CPT_ACCOUNT="${CPT_ACCOUNT:-a0140}"
CPT_PARTITION="${CPT_PARTITION:-normal}"
CPT_UENV="${CPT_UENV:-pytorch/v2.9.1:v2}"
SCRATCH_ROOT="${SCRATCH_ROOT:-/iopsstor/scratch/cscs/fffoivos}"
CAP_ROOT="${CAP_ROOT:-/capstor/scratch/cscs/fffoivos}"
REPO_ROOT="${REPO_ROOT:?set REPO_ROOT to the clean immutable training checkout}"
CPT_DIR="$REPO_ROOT/subprojects/05_token_distillation_cpt/06_25b_midtraining_probe"
LEGACY_DIR="$REPO_ROOT/subprojects/05_token_distillation_cpt/05_training_dataset_bridge"
CPT_RUN_ID="${CPT_RUN_ID:?set one immutable CPT_RUN_ID}"
STAGE_ROOT="${STAGE_ROOT:-$CAP_ROOT/cpt_corpus_clariden/cpt25b_midtraining/$CPT_RUN_ID}"
RUN_ROOT="${RUN_ROOT:-$CAP_ROOT/runs/05_token_distillation_cpt/25b_midtraining/$CPT_RUN_ID}"
RUNTIME_VENV="${RUNTIME_VENV:-$SCRATCH_ROOT/python_envs/greek_cpt25b_v1_py312}"
RUNTIME_RECEIPT="$RUNTIME_VENV/runtime_receipt.json"

DATASET_ROOT="${DATASET_ROOT:-$CAP_ROOT/cpt_corpus_clariden/greek-cleaned-v2-3f97cec4}"
DATASET_MANIFEST="$DATASET_ROOT/manifests/deduplicated_manifest.json"
DATASET_DONOR="${DATASET_DONOR:-$CAP_ROOT/cpt_corpus_clariden/agent1-v5-clariden-debug-20260715T111552Z-30c72e9/release-deduplicated}"
TOKENIZER_DIR="${TOKENIZER_DIR:-$SCRATCH_ROOT/tokenizers/apertus_greek_modern_polytonic_148992}"
MEGATRON_DIR="${MEGATRON_DIR:-$SCRATCH_ROOT/code/training/Megatron-LM-Swiss-AI}"

RECIPE="$CPT_DIR/configs/recipe_25b_midtraining.json"
LEGACY_CONFIG="$LEGACY_DIR/configs/frozen_25b_td.json"
REPLAY_CONFIG="$LEGACY_DIR/configs/replay_acquisition.json"
REPLAY_RECEIPT="$STAGE_ROOT/receipts/replay_acquisition_receipt.json"
OLD_GREEK_RECEIPT="$STAGE_ROOT/receipts/old_greek_build_receipt.json"
DECONTAM_DIR="$STAGE_ROOT/greekmmlu"
DECONTAM_QUERIES="$DECONTAM_DIR/greekmmlu.jsonl"
DECONTAM_QUERY_SUMMARY="$DECONTAM_DIR/build_summary.json"
DECONTAM_QUERY_MANIFEST="$DECONTAM_DIR/greekmmlu.jsonl.manifest.json"
DECONTAM_BINDING="$DECONTAM_DIR/decontamination_binding.json"
INPUT_RECEIPT="$STAGE_ROOT/input_receipt.json"
HELDOUT_MANIFEST="$STAGE_ROOT/heldouts/heldout_manifest.json"
BRIDGE_MANIFEST="$STAGE_ROOT/bridge_manifest.json"
TRAINING_DATA_ENV="$STAGE_ROOT/training_data.env"

BASE_INIT_HF="${BASE_INIT_HF:-$CAP_ROOT/models/apertus-tokenizer-extension-fcd33ec/TokenDistil-Init}"
INIT_ROOT="${INIT_ROOT:-$CAP_ROOT/models/greek-cpt25b-init/$CPT_RUN_ID}"
ROUNDTRIP_ROOT="${ROUNDTRIP_ROOT:-$CAP_ROOT/models/greek-cpt25b-init-roundtrip/$CPT_RUN_ID}"
TRAINING_ASSETS_RECEIPT="$STAGE_ROOT/training_assets_receipt.json"
TOKENIZER_PROBE_ROOT="${TOKENIZER_PROBE_ROOT:-$SCRATCH_ROOT/tokenizer_finalization/20260729T094000Z-poly512-1024}"

cpt_python() {
  uenv run "$CPT_UENV" --view=default -- "$RUNTIME_VENV/bin/python" "$@"
}

cpt_require_runtime() {
  test -s "$RUNTIME_RECEIPT" || { echo "ERROR: runtime receipt missing: $RUNTIME_RECEIPT" >&2; return 2; }
  cpt_python -c 'import datasets,pyarrow,tokenizers; assert pyarrow.__version__ == "21.0.0"' >/dev/null
}
