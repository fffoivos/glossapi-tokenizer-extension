# Task-2 TD-17k Path-A CPT regime config.
# Sourced by the 03 bakeoff training script through TRAIN_CONFIG_OVERRIDE.
#
# This mirrors /home/foivos/Projects/greek-apertus/configs/training/cpt.env
# using the legacy variable names expected by bakeoff_train.sbatch. Keep the
# public greek-apertus config as the source of truth for the regime; this file
# is the executable compatibility shim for the TD checkpoint-bounded launcher.

APERTUS_BASE_HF="/iopsstor/scratch/cscs/fffoivos/models/apertus-8b-2509"
APERTUS_BASE_MEGATRON="/iopsstor/scratch/cscs/fffoivos/init_checkpoints/modern_only_148480/vanilla/megatron_tp2_r17patched"

MEGATRON_LM_SWISSAI_DIR="/iopsstor/scratch/cscs/fffoivos/code/training/Megatron-LM-Swiss-AI"
MEGATRON_LM_SWISSAI_COMMIT="c92402e39ef3c8e69ea378a59e79059dc14541f4"

# Path A positional geometry.
MAX_POSITION_EMBEDDINGS="${MAX_POSITION_EMBEDDINGS:-65536}"
ROTARY_BASE="${ROTARY_BASE:-12000000}"
USE_ROPE_SCALING="${USE_ROPE_SCALING:-1}"
ROPE_SCALING_FACTOR="${ROPE_SCALING_FACTOR:-8.0}"
MAKE_VOCAB_SIZE_DIVISIBLE_BY="${MAKE_VOCAB_SIZE_DIVISIBLE_BY:-256}"

ADEMA_BETA1="0.9"
ADEMA_BETA2="0.999"
ADEMA_BETA3="0.99"
ADEMA_ALPHA="8.0"
ADEMA_WEIGHT_DECAY="0.1"
ADEMA_BETA3_WARMUP_STEPS="${ADEMA_BETA3_WARMUP_STEPS:-287}"
ADEMA_ALPHA_WARMUP_STEPS="${ADEMA_ALPHA_WARMUP_STEPS:-287}"
ADEMA_BETA_START="$ADEMA_BETA1"

INIT_STD="0.008944"
LR_PEAK="1.1e-5"
LR_FINAL="1.1e-5"
LR_SCHEDULE_STYLE="${LR_SCHEDULE_STYLE:-constant}"
LR_WARMUP_INIT="${LR_WARMUP_INIT:-1.1e-6}"
LR_WARMUP_TOKENS="${LR_WARMUP_TOKENS:-1200000000}"
LR_DECAY_STYLE="${LR_DECAY_STYLE:-1-sqrt}"

GRAD_CLIP="0.1"

SEQ_LENGTH="4096"
MICROBATCH_SIZE="2"
GLOBAL_BATCH_SIZE="1024"
GLOBAL_BATCH_TOKENS="4194304"

LOSS_OBJECTIVE="${LOSS_OBJECTIVE:-goldfish}"
GOLDFISH_K="50"
GOLDFISH_H="50"

CROSS_DOC_ATTN_FLAGS="--reset-attention-mask --reset-position-ids"
EOD_LOSS_MASK_FLAG="--eod-mask-loss"

MIXED_PRECISION_FLAG="--bf16"
MAIN_GRADS_DTYPE="fp32"

ACTIVATION_FLAG="--xielu"
XIELU_INIT_AP="0.8"
XIELU_INIT_AN="0.8"
QK_LAYERNORM_FLAG="--qk-layernorm"
QKNORM_IMPL="apex"
NORMALIZATION="RMSNorm"

BASE_TOKENIZER_DIR="${BASE_TOKENIZER_DIR:-/iopsstor/scratch/cscs/fffoivos/models/apertus-8b-2509}"
EXT_TOKENIZER_DIR="${EXT_TOKENIZER_DIR:-/iopsstor/scratch/cscs/fffoivos/tokenizers/apertus_greek_modern_only_148480}"

# The TD submitter must provide EXT_DATA_PREFIX explicitly. Leaving this empty
# prevents accidentally training TD on the base-tokenized DATA_PREFIX.
BASE_DATA_PREFIX="${BASE_DATA_PREFIX:-}"
EXT_DATA_PREFIX="${EXT_DATA_PREFIX:-}"

DATA_SEED="${DATA_SEED:-20260528}"
DATALOADER_WORKERS="${DATALOADER_WORKERS:-4}"

SAVE_INTERVAL="${SAVE_INTERVAL:-119}"
EVAL_INTERVAL="${EVAL_INTERVAL:-25}"
EXIT_INTERVAL="${EXIT_INTERVAL:-}"
RESUME_TRAINING="${RESUME_TRAINING:-0}"
DISABLE_SAVE="${DISABLE_SAVE:-0}"

TRAIN_TOKENS="${TRAIN_TOKENS:-5000000000}"
TRAIN_SAMPLES="$(( TRAIN_TOKENS / SEQ_LENGTH ))"
TRAIN_ITERS="$(( TRAIN_SAMPLES / GLOBAL_BATCH_SIZE ))"

TENSOR_MODEL_PARALLEL_SIZE="2"
PIPELINE_MODEL_PARALLEL_SIZE="1"
PARTITION="${PARTITION:-normal}"
TIME_LIMIT="${TIME_LIMIT:-48:00:00}"
NODES="${NODES:-1}"
GPUS_PER_NODE="${GPUS_PER_NODE:-4}"
LAUNCH_MODE="${LAUNCH_MODE:-slurm}"
ACCOUNT="${ACCOUNT:-a0140}"
UENV_IMAGE="${UENV_IMAGE:-pytorch/v2.9.1:v2}"
