# Shared MLP paths; override only before freezing a new immutable run ID.
LR13_CODE_ROOT="${LR13_CODE_ROOT:?set LR13_CODE_ROOT to the deployed immutable experiment code}"
LR13_RUN_ID="${LR13_RUN_ID:?set one immutable LR13_RUN_ID}"
LR13_CAP_ROOT="${LR13_CAP_ROOT:-/capstor/scratch/cscs/fffoivos}"
LR13_DATA_ROOT="${LR13_DATA_ROOT:-$LR13_CAP_ROOT/cpt_corpus_clariden/lr_floor_13b/$LR13_RUN_ID}"
LR13_RUN_ROOT="${LR13_RUN_ROOT:-$LR13_CAP_ROOT/runs/05_token_distillation_cpt/lr_floor_13b/$LR13_RUN_ID}"
LR13_RECIPE="$LR13_CODE_ROOT/configs/recipe_13b_lr_floor.json"
LR13_DATASET_MANIFEST="$LR13_DATA_ROOT/dataset_manifest.json"
LR13_TRAINING_DATA_ENV="$LR13_DATA_ROOT/training_data.env"
LR13_ASSETS_RECEIPT="$LR13_DATA_ROOT/training_assets_receipt.json"

