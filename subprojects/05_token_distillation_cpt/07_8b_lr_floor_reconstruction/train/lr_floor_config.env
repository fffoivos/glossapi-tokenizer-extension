# Exact 13.5B two-phase adapter for bakeoff_train.sbatch.
: "${LR13_TRAINING_DATA_ENV:?set LR13_TRAINING_DATA_ENV}"
: "${LR13_PHASE:?set LR13_PHASE to 1 or 2}"
: "${LR13_START_ITERATION:?set LR13_START_ITERATION}"
: "${LR13_END_ITERATION:?set LR13_END_ITERATION}"
: "${LR13_LR_FLOOR_PERCENT:?set LR13_LR_FLOOR_PERCENT to 10, 20 or 30}"
: "${LR13_SOURCE_REPO:?set LR13_SOURCE_REPO}"

source "$LR13_SOURCE_REPO/subprojects/05_token_distillation_cpt/03_training_experiments/configs/common_cpt.env"
source "$LR13_TRAINING_DATA_ENV"

# The common source config records the upstream base. This experiment runs the
# clean, pinned descendant that restores the proven named-validation hook.
MEGATRON_LM_SWISSAI_COMMIT="f8d8a30ba22a807321ec5875abbd9692b9282940"

case "$LR13_PHASE" in
  1)
    LR13_DATA_PREFIX="$PHASE1_CPT_DATA_PREFIX"
    CPT_PHASE_START_ITERATION=0
    ;;
  2)
    LR13_DATA_PREFIX="$PHASE2_CPT_DATA_PREFIX"
    CPT_PHASE_START_ITERATION=2253
    ;;
  *) echo "ERROR: LR13_PHASE must be 1 or 2" >&2; return 2 ;;
esac
case "$LR13_LR_FLOOR_PERCENT" in
  10) LR_FINAL="5.5e-6" ;;
  20) LR_FINAL="1.10e-5" ;;
  30) LR_FINAL="1.65e-5" ;;
  *) echo "ERROR: LR13_LR_FLOOR_PERCENT must be 10, 20 or 30" >&2; return 2 ;;
esac

ARM=td
ARM_NAME="apertus8b_lr_floor_${LR13_LR_FLOOR_PERCENT}_phase_${LR13_PHASE}"
BASE_TOKENIZER_DIR="$FULL_CPT_TOKENIZER_DIR"
EXT_TOKENIZER_DIR="$FULL_CPT_TOKENIZER_DIR"
BASE_DATA_PREFIX="$LR13_DATA_PREFIX"
EXT_DATA_PREFIX="$LR13_DATA_PREFIX"
TRAIN_TOKENS=13500000000
TRAIN_SAMPLES=3295898
TRAIN_ITERS=3218
LR_PEAK="5.5e-5"
LR_WARMUP_INIT="5.5e-6"
LR_WARMUP_ITERS=400
LR_WARMUP_TOKENS=1677721600
LR_WSD_DECAY_SAMPLES=659179
ADEMA_BETA1="0.9"
ADEMA_BETA2="0.999"
ADEMA_BETA3="0.999"
ADEMA_ALPHA="4.0"
ADEMA_BETA3_WARMUP_STEPS=3218
ADEMA_ALPHA_WARMUP_STEPS=3218
CURRICULUM_ORDER_MODE=randomized
DATA_SEED=20260609
USE_MOCK_DATA=0
ENABLE_EXTRA_VALID=1
SAVE_INTERVAL="${LR13_SAVE_INTERVAL:?set LR13_SAVE_INTERVAL}"
EVAL_INTERVAL=25
EVAL_ITERS=1
EXIT_INTERVAL="$LR13_END_ITERATION"
RESUME_TRAINING=0
if (( LR13_START_ITERATION > 0 )); then RESUME_TRAINING=1; fi
TRAINER_WRAPPER="$LR13_SOURCE_REPO/subprojects/05_token_distillation_cpt/07_8b_lr_floor_reconstruction/train/runtime_patches/lr_floor_resume.py"
CPT_MIN_LR_OVERRIDE="$LR_FINAL"
CPT_GLOBAL_BATCH_SIZE=1024
NODES=16
GPUS_PER_NODE=4
TIME_LIMIT="${LR13_TIME_LIMIT:-08:00:00}"
ACCOUNT=a0140
PARTITION=normal
LAUNCH_MODE=torchrun
UENV_IMAGE="pytorch/v2.9.1:v2"

export CPT_PHASE_START_ITERATION CPT_GLOBAL_BATCH_SIZE CPT_MIN_LR_OVERRIDE
export TRAINER_WRAPPER CURRICULUM_ORDER_MODE DATA_SEED
export EXIT_INTERVAL RESUME_TRAINING LR_FINAL SAVE_INTERVAL
export NEW_GREEK_VALID_SETS EXTRA_VALID_SETS VAL_DATA_DIR
