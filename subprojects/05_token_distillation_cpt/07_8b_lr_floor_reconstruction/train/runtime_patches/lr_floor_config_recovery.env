# Recovery adapter for checkpoints created before lr_floor_resume.py was frozen.
# The original frozen config remains unchanged on the live run and is validated
# by preflight.  This adapter sources it, then installs only the post-restore
# parameter-group LR-floor correction.
: "${LR13_CODE_ROOT:?set LR13_CODE_ROOT}"
: "${LR13_RECOVERY_BUNDLE:?set LR13_RECOVERY_BUNDLE}"

source "$LR13_CODE_ROOT/train/lr_floor_config.env"

TRAINER_WRAPPER="$LR13_RECOVERY_BUNDLE/lr_floor_resume.py"
CPT_MIN_LR_OVERRIDE="$LR_FINAL"
export TRAINER_WRAPPER CPT_MIN_LR_OVERRIDE
