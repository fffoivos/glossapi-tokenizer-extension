@@ -2019,3 +2045,17 @@ def build_train_valid_test_data_iterators(
         test_data_iterator = None
 
     return train_data_iterator, valid_data_iterator, test_data_iterator
+
+
+def build_extra_valid_data_iterators(build_extra_valid_datasets_provider):
+    """Build cyclic iterators for independently reported validation sets."""
+    if build_extra_valid_datasets_provider is None:
+        return []
+    result = []
+    for name, dataset in build_extra_valid_datasets_provider():
+        dataloader = build_pretraining_data_loader(dataset, 0)
+        data_iterator = None
+        if dataloader is not None:
+            data_iterator = RerunDataIterator(iter(cyclic_iter(dataloader)))
+        result.append((name, data_iterator))
+    return result
diff --git a/pretrain_gpt.py b/pretrain_gpt.py
