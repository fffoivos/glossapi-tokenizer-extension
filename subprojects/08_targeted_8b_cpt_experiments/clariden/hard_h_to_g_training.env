# Frozen two-scale HPLT -> OpenArchives CPT adapter for bakeoff_train.sbatch.
: "${H2G_CODE_ROOT:?set immutable code root}"
: "${H2G_STAGE_ROOT:?set immutable stage root}"
: "${H2G_MODEL_SCALE:?set 8b or 1p5b}"
: "${H2G_PHASE:?set 1, 2 or 3}"
: "${H2G_PEAK_LR:?set frozen scale-specific peak LR}"
: "${H2G_FLOOR_LR:?set exact 0.1-times peak LR}"
: "${H2G_PHASE_DATA_PATH:?set exact ordered weighted --data-path string}"
: "${H2G_PHASE_CACHE_ROOT:?set exact phase GPTDataset cache root}"
: "${H2G_MEGATRON_DIR:?set pinned patched Megatron root}"
: "${H2G_EXIT_UPDATE:?set exact segment exit update}"
: "${H2G_MICROBATCH_SIZE:?set promoted profile microbatch}"
: "${H2G_TENSOR_PARALLEL_SIZE:?set promoted profile TP}"
: "${H2G_LR_POLICY:?set matched_wsd or stable_peak}"

source "$H2G_CODE_ROOT/frozen_training_tools/common_cpt.env"

MEGATRON_LM_SWISSAI_DIR="$H2G_MEGATRON_DIR"
MEGATRON_LM_SWISSAI_COMMIT="c92402e39ef3c8e69ea378a59e79059dc14541f4"
BASE_TOKENIZER_DIR="$H2G_STAGE_ROOT/assets/tokenizer_148480"
EXT_TOKENIZER_DIR="$BASE_TOKENIZER_DIR"
BASE_DATA_PREFIX="$H2G_PHASE_DATA_PATH"
EXT_DATA_PREFIX="$H2G_PHASE_DATA_PATH"
ARM=td

case "$H2G_MODEL_SCALE" in
  8b)
    MODEL_NUM_LAYERS=32
    MODEL_HIDDEN_SIZE=4096
    MODEL_FFN_HIDDEN_SIZE=21504
    MODEL_NUM_ATTENTION_HEADS=32
    MODEL_NUM_QUERY_GROUPS=8
    [[ "$H2G_PEAK_LR" == "5.5e-5" && "$H2G_FLOOR_LR" == "5.5e-6" ]] || {
      echo "8B LR contract drift" >&2; return 2;
    }
    [[ "$H2G_TENSOR_PARALLEL_SIZE" == 2 && "$H2G_MICROBATCH_SIZE" == 2 ]] || {
      echo "8B promoted profile drift" >&2; return 2;
    }
    ;;
  1p5b)
    MODEL_NUM_LAYERS=16
    MODEL_HIDDEN_SIZE=2048
    MODEL_FFN_HIDDEN_SIZE=12288
    MODEL_NUM_ATTENTION_HEADS=32
    MODEL_NUM_QUERY_GROUPS=8
    ;;
  *) echo "invalid H2G_MODEL_SCALE=$H2G_MODEL_SCALE" >&2; return 2 ;;
esac

MICROBATCH_SIZE="$H2G_MICROBATCH_SIZE"
GLOBAL_BATCH_SIZE=1024
GLOBAL_BATCH_TOKENS=4194304
TENSOR_MODEL_PARALLEL_SIZE="$H2G_TENSOR_PARALLEL_SIZE"
PIPELINE_MODEL_PARALLEL_SIZE=1
MAKE_VOCAB_SIZE_DIVISIBLE_BY=256
MAX_POSITION_EMBEDDINGS=4096
ROTARY_BASE=500000
USE_ROPE_SCALING=1
ROPE_SCALING_FACTOR=8.0
CURRICULUM_ORDER_MODE=randomized
MEGATRON_GPT_DATASET_NO_SHUFFLE=0
DATA_SEED=20260609
LOSS_OBJECTIVE=goldfish
GOLDFISH_K=50
GOLDFISH_H=50
ADEMA_BETA1=0.9
ADEMA_BETA2=0.999
ADEMA_BETA3=0.999
ADEMA_ALPHA=4.0
ADEMA_WEIGHT_DECAY=0.1
ADEMA_BETA3_WARMUP_STEPS=3218
ADEMA_ALPHA_WARMUP_STEPS=3218
GRAD_CLIP=0.1
LR_PEAK="$H2G_PEAK_LR"
LR_FINAL="$H2G_FLOOR_LR"
LR_WARMUP_INIT="$H2G_FLOOR_LR"
LR_WARMUP_ITERS=400
LR_WARMUP_TOKENS=1677721600
LR_WSD_DECAY_SAMPLES=659179
SEQ_LENGTH=4096
CROSS_DOC_ATTN_FLAGS="--reset-attention-mask --reset-position-ids"
EOD_LOSS_MASK_FLAG="--eod-mask-loss"
MIXED_PRECISION_FLAG="--bf16"
MAIN_GRADS_DTYPE=fp32
SAVE_INTERVAL="${H2G_SAVE_INTERVAL_OVERRIDE:-119}"
EVAL_INTERVAL="${H2G_EVAL_INTERVAL_OVERRIDE:-25}"
EVAL_ITERS=1
EXIT_INTERVAL="$H2G_EXIT_UPDATE"
RESUME_TRAINING=0
(( H2G_START_UPDATE == 0 )) || RESUME_TRAINING=1
DISABLE_SAVE=0
USE_MOCK_DATA=0
ENABLE_EXTRA_VALID=1
VAL_DATA_DIR="${H2G_VAL_DATA_DIR:?set frozen online-validation binary root}"
EXTRA_VALID_SETS="${H2G_EXTRA_VALID_SETS:?set frozen online validation panel names}"
NEW_GREEK_VALID_SETS="${H2G_NEW_GREEK_VALID_SETS:?set frozen Greek learning panel names}"
DATALOADER_WORKERS="${H2G_DATALOADER_WORKERS:-4}"
NODES="${SLURM_NNODES:?training config requires a Slurm allocation}"
GPUS_PER_NODE=4
LAUNCH_MODE=torchrun
PARTITION=normal
ACCOUNT=a0140
UENV_IMAGE=pytorch/v2.9.1:v2
TIME_LIMIT="${H2G_TIME_LIMIT:-12:00:00}"
FULL_CPT_LAUNCH_VERIFY=0

case "$H2G_PHASE" in
  1)
    CPT_PHASE_START_ITERATION=0
    TRAIN_TOKENS=13500000000
    LR_SCHEDULE_STYLE=WSD
    TRAINER_WRAPPER=""
    ;;
  2)
    if [[ -n "${H2G_PHASE_START_UPDATE_OVERRIDE:-}" ]]; then
      [[ "${H2G_PRELAUNCH_PHASE2_RESTART_SMOKE:-0}" == 1 && "$H2G_PHASE_START_UPDATE_OVERRIDE" == 1 ]] || {
        echo "Phase-2 start override is reserved for the frozen prelaunch restart smoke" >&2; return 2;
      }
      CPT_PHASE_START_ITERATION="$H2G_PHASE_START_UPDATE_OVERRIDE"
    else
      CPT_PHASE_START_ITERATION=2261
    fi
    TRAIN_TOKENS=13500000000
    LR_SCHEDULE_STYLE=WSD
    TRAINER_WRAPPER="$H2G_CODE_ROOT/subprojects/08_targeted_8b_cpt_experiments/scripts/phase_local_data_index_guard.py"
    ;;
  3)
    CPT_PHASE_START_ITERATION=3218
    TRAIN_TOKENS=15493758976
    LR_SCHEDULE_STYLE=constant
    LR_PEAK="$H2G_FLOOR_LR"
    LR_FINAL="$H2G_FLOOR_LR"
    LR_WARMUP_INIT="$H2G_FLOOR_LR"
    LR_WARMUP_TOKENS=0
    H2G_CONSTANT_FLOOR_LR="$H2G_FLOOR_LR"
    TRAINER_WRAPPER="$H2G_CODE_ROOT/subprojects/08_targeted_8b_cpt_experiments/scripts/constant_floor_resume.py"
    PHASE_LOCAL_DATASET_SIZE_OVERRIDE=1
    EXPECTED_GLOBAL_TRAIN_SAMPLES=3782656
    EXPECTED_PHASE_DATASET_SAMPLES=487424
    export PHASE_LOCAL_DATASET_SIZE_OVERRIDE EXPECTED_GLOBAL_TRAIN_SAMPLES EXPECTED_PHASE_DATASET_SAMPLES
    export H2G_CONSTANT_FLOOR_LR
    ;;
  *) echo "invalid H2G_PHASE=$H2G_PHASE" >&2; return 2 ;;
esac

case "$H2G_LR_POLICY" in
  matched_wsd) ;;
  stable_peak)
    [[ "$H2G_MODEL_SCALE" == 8b && ( "$H2G_PHASE" == 2 || "$H2G_PHASE" == 3 ) ]] || {
      echo "stable-peak LR is authorized only for the 8B Phase-2/3 branch" >&2; return 2;
    }
    [[ "$H2G_PEAK_LR" == "5.5e-5" ]] || {
      echo "stable-peak branch LR drift" >&2; return 2;
    }
    LR_SCHEDULE_STYLE=constant
    LR_PEAK="$H2G_PEAK_LR"
    LR_FINAL="$H2G_PEAK_LR"
    LR_WARMUP_INIT="$H2G_PEAK_LR"
    LR_WARMUP_ITERS=0
    LR_WARMUP_TOKENS=0
    H2G_CONSTANT_FLOOR_LR="$H2G_PEAK_LR"
    TRAINER_WRAPPER="$H2G_CODE_ROOT/subprojects/08_targeted_8b_cpt_experiments/scripts/constant_floor_resume.py"
    export H2G_CONSTANT_FLOOR_LR
    ;;
  *) echo "invalid H2G_LR_POLICY=$H2G_LR_POLICY" >&2; return 2 ;;
esac

CPT_GLOBAL_BATCH_SIZE=1024
export CPT_PHASE_START_ITERATION CPT_GLOBAL_BATCH_SIZE H2G_CODE_ROOT
if (( H2G_PHASE > 1 )); then
  PHASE_LOCAL_DATA_INDEX=1
  PHASE_START_UPDATE="$CPT_PHASE_START_ITERATION"
  EXPECTED_GLOBAL_UPDATE="$H2G_START_UPDATE"
  GLOBAL_BATCH_SIZE="$CPT_GLOBAL_BATCH_SIZE"
  EXPECTED_PHASE_LOCAL_CONSUMED_SAMPLES="$(( (H2G_START_UPDATE - CPT_PHASE_START_ITERATION) * CPT_GLOBAL_BATCH_SIZE ))"
  EXPECTED_DATA_CACHE_SHA256="$H2G_PHASE_CACHE_TREE_SHA256"
  ACTUAL_DATA_CACHE_SHA256="$H2G_PHASE_CACHE_TREE_SHA256"
  export PHASE_LOCAL_DATA_INDEX PHASE_START_UPDATE EXPECTED_GLOBAL_UPDATE GLOBAL_BATCH_SIZE
  export EXPECTED_PHASE_LOCAL_CONSUMED_SAMPLES EXPECTED_DATA_CACHE_SHA256 ACTUAL_DATA_CACHE_SHA256
fi
export MODEL_NUM_LAYERS MODEL_HIDDEN_SIZE MODEL_FFN_HIDDEN_SIZE
export MODEL_NUM_ATTENTION_HEADS MODEL_NUM_QUERY_GROUPS
export TRAINER_WRAPPER CURRICULUM_ORDER_MODE DATA_SEED
