# 04a Path-A-geometry-probe training config.
# Sourced by bakeoff_train.sbatch (env-var-driven post-2026-05-31 patch).
#
# Tests the geometry-perturbation hypothesis from TASK2_HANDOFF §2.3:
# can the model learn Greek without the rope re-adaptation cost we paid
# in Task 1 under Path-B (rope=500K override on Path-A weights)?
#
# DIFFERENCE FROM train_config_04_vanilla.env:
#   - MAX_POSITION_EMBEDDINGS=65536       (Path A)
#   - ROTARY_BASE=12000000                (Path A)
#   - USE_ROPE_SCALING=1                  (Path A llama3 scaling)
#   - ROPE_SCALING_FACTOR=8.0             (Path A — Apertus paper §2.5)
#   - TRAIN_TOKENS=500000000              (0.5 B = iter 119, matched to Task 1's iter 119)
# All other settings IDENTICAL to Task 1 vanilla config so the only
# intentional difference is geometry.
#
# See PATH_A_GEOMETRY_PROBE_PLAN.md for the full spec + decision rule.

APERTUS_BASE_HF="/iopsstor/scratch/cscs/fffoivos/models/apertus-8b-2509"
APERTUS_BASE_MEGATRON="/iopsstor/scratch/cscs/fffoivos/init_checkpoints/modern_only_148480/vanilla/megatron_tp2_r17patched"

MEGATRON_LM_SWISSAI_DIR="/iopsstor/scratch/cscs/fffoivos/code/training/Megatron-LM-Swiss-AI"
MEGATRON_LM_SWISSAI_COMMIT="c92402e39ef3c8e69ea378a59e79059dc14541f4"

# ===== POSITIONAL GEOMETRY (the change being tested) =====
# Path A = Apertus paper §2.5 long-context extension geometry; also what
# the released swiss-ai/Apertus-8B-2509 config.json carries.
MAX_POSITION_EMBEDDINGS="65536"
ROTARY_BASE="12000000"
USE_ROPE_SCALING="1"
ROPE_SCALING_FACTOR="8.0"

# ===== OPTIMIZER (unchanged from Task 1) =====
ADEMA_BETA1="0.9"
ADEMA_BETA2="0.999"
ADEMA_BETA3="0.99"
ADEMA_ALPHA="8.0"
ADEMA_WEIGHT_DECAY="0.1"
ADEMA_BETA3_WARMUP_STEPS="${ADEMA_BETA3_WARMUP_STEPS:-287}"
ADEMA_ALPHA_WARMUP_STEPS="${ADEMA_ALPHA_WARMUP_STEPS:-287}"
ADEMA_BETA_START="$ADEMA_BETA1"

INIT_STD="0.008944"
LR_PEAK="1.1e-5"
LR_FINAL="1.1e-5"
LR_SCHEDULE_STYLE="${LR_SCHEDULE_STYLE:-constant}"
LR_WARMUP_INIT="${LR_WARMUP_INIT:-1.1e-6}"
LR_WARMUP_TOKENS="${LR_WARMUP_TOKENS:-1200000000}"
LR_DECAY_STYLE="1-sqrt"

GRAD_CLIP="0.1"

# ===== SEQUENCE + BATCH (unchanged from Task 1) =====
SEQ_LENGTH="4096"
MICROBATCH_SIZE="2"
GLOBAL_BATCH_SIZE="1024"
GLOBAL_BATCH_TOKENS="4194304"

LOSS_OBJECTIVE="${LOSS_OBJECTIVE:-goldfish}"
GOLDFISH_K="50"
GOLDFISH_H="50"

CROSS_DOC_ATTN_FLAGS="--reset-attention-mask --reset-position-ids"
EOD_LOSS_MASK_FLAG="--eod-mask-loss"

MIXED_PRECISION_FLAG="--bf16"
MAIN_GRADS_DTYPE="fp32"

ACTIVATION_FLAG="--xielu"
XIELU_INIT_AP="0.8"
XIELU_INIT_AN="0.8"
QK_LAYERNORM_FLAG="--qk-layernorm"
QKNORM_IMPL="apex"
NORMALIZATION="RMSNorm"

# ===== TOKENIZER (unchanged; base 131,072) =====
BASE_TOKENIZER_DIR="/iopsstor/scratch/cscs/fffoivos/models/apertus-8b-2509"
EXT_TOKENIZER_DIR="/iopsstor/scratch/cscs/fffoivos/tokenizers/apertus_greek_modern_only_148480"

# ===== DATA (same Task-1 dataset) =====
BASE_DATA_PREFIX="${BASE_DATA_PREFIX:-/capstor/scratch/cscs/fffoivos/runs/04_vanilla_cpt/latest_dataset/megatron/hplt_b1_base_text_document}"
EXT_DATA_PREFIX="${EXT_DATA_PREFIX:-$BASE_DATA_PREFIX}"

DATA_SEED="${DATA_SEED:-20260528}"
DATALOADER_WORKERS="${DATALOADER_WORKERS:-4}"

# ===== CHECKPOINTING (single save at iter 119, then exit early) =====
SAVE_INTERVAL="${SAVE_INTERVAL:-119}"
EVAL_INTERVAL="${EVAL_INTERVAL:-999999}"
EXIT_INTERVAL="${EXIT_INTERVAL:-119}"
RESUME_TRAINING="${RESUME_TRAINING:-0}"
DISABLE_SAVE="${DISABLE_SAVE:-0}"

# Effective training: iter 119 (~0.5B tokens), matched to Task 1 iter 119.
# The Megatron OptimizerParamScheduler requires
# `lr_warmup_steps < lr_decay_steps`. lr_decay_steps is driven by
# TRAIN_TOKENS / SEQ_LENGTH / GLOBAL_BATCH_SIZE; the regime's
# warmup is 1.2 B tokens (= ~287 steps at our 4.194 M global batch).
# So TRAIN_TOKENS must be > 1.2 B to satisfy the assertion. We set it
# to 1.5 B (the scheduler's notional run length), then EXIT_INTERVAL=119
# stops training at iter 119. Actual training cost reflects iter 119
# only; scheduler shape matches a hypothetical 1.5 B run (same
# warmup-then-constant we want to test).
TRAIN_TOKENS="${TRAIN_TOKENS:-1500000000}"
TRAIN_SAMPLES="$(( TRAIN_TOKENS / SEQ_LENGTH ))"
TRAIN_ITERS="$(( TRAIN_SAMPLES / GLOBAL_BATCH_SIZE ))"

# ===== PARALLELISM + LAUNCH =====
TENSOR_MODEL_PARALLEL_SIZE="2"
PIPELINE_MODEL_PARALLEL_SIZE="1"
PARTITION="${PARTITION:-normal}"
TIME_LIMIT="${TIME_LIMIT:-08:00:00}"
NODES="${NODES:-1}"
GPUS_PER_NODE="${GPUS_PER_NODE:-4}"
LAUNCH_MODE="${LAUNCH_MODE:-slurm}"
ACCOUNT="${ACCOUNT:-a0140}"
UENV_IMAGE="${UENV_IMAGE:-pytorch/v2.9.1:v2}"
